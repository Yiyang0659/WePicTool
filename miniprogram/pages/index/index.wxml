<!--pages/index/index.wxml-->
<view class="container">
  <!-- ===== 步骤一：首页选图入口 ===== -->
  <block wx:if="{{step === 'home'}}">
    <view class="home-question">今天想做什么？</view>

    <view class="home-play-switch" role="tablist">
      <view
        class="home-play-option home-play-layered {{activeHomePlay === 'layered-dressup' ? 'home-play-option-active' : ''}}"
        role="tab"
        aria-selected="{{activeHomePlay === 'layered-dressup'}}"
        data-play-id="layered-dressup"
        bindtap="onSelectHomePlay"
      >
        <view class="home-play-icon home-play-icon-layered">👕</view>
        <view class="home-play-copy">
          <view class="home-play-title">分层换装</view>
          <view class="home-play-desc">四个部位自由滑动组合</view>
        </view>
        <view class="home-play-check" wx:if="{{activeHomePlay === 'layered-dressup'}}">✓</view>
      </view>
      <view
        class="home-play-option home-play-funtext {{activeHomePlay === 'fun-text-stack' ? 'home-play-option-active' : ''}}"
        role="tab"
        aria-selected="{{activeHomePlay === 'fun-text-stack'}}"
        data-play-id="fun-text-stack"
        bindtap="onSelectHomePlay"
      >
        <view class="home-play-icon home-play-icon-funtext">✍</view>
        <view class="home-play-copy">
          <view class="home-play-title">趣味字画</view>
          <view class="home-play-desc">一句话变成三套可滑卡片</view>
        </view>
        <view class="home-play-check home-play-check-pink" wx:if="{{activeHomePlay === 'fun-text-stack'}}">✓</view>
      </view>
    </view>

    <view class="home-shared-preview">
      <block wx:if="{{activeHomePlay === 'layered-dressup'}}">
        <view class="home-preview-head">
          <view>
            <view class="home-preview-title">分层换装</view>
            <view class="home-preview-sub">四个部位独立滑动，搭配出你的专属风格</view>
          </view>
          <view class="home-preview-tag">随心搭配</view>
        </view>

        <view class="layered-preview-layout">
          <view class="layered-choice-list">
            <view class="layered-choice-row" wx:for="{{layeredDemoViewRows}}" wx:key="key" wx:for-item="row">
              <view class="layered-choice-meta">
                <view class="layered-choice-name"><text>{{row.emoji}}</text><text>{{row.name}}</text></view>
                <view class="layered-choice-count">{{row.currentIndex + 1}} / {{row.total}}</view>
              </view>
              <view class="layered-choice-controls">
                <view class="layered-choice-arrow" data-group-key="{{row.key}}" data-direction="-1" bindtap="onShiftLayeredDemoItem">‹</view>
                <view class="layered-thumb-strip">
                  <view
                    class="layered-thumb {{image.selected ? 'layered-thumb-active' : ''}}"
                    wx:for="{{row.images}}"
                    wx:key="src"
                    wx:for-item="image"
                    data-group-key="{{row.key}}"
                    data-index="{{image.index}}"
                    bindtap="onSelectLayeredDemoItem"
                  >
                    <image src="{{image.src}}" mode="aspectFit" />
                  </view>
                </view>
                <view class="layered-choice-arrow" data-group-key="{{row.key}}" data-direction="1" bindtap="onShiftLayeredDemoItem">›</view>
              </view>
            </view>
          </view>

          <view class="layered-current-panel">
            <view class="layered-current-title">当前选择</view>
            <view class="layered-current-grid">
              <view class="layered-current-cell" wx:for="{{layeredCurrentItems}}" wx:key="key">
                <image src="{{item.src}}" mode="aspectFit" />
              </view>
            </view>
            <view class="layered-current-note">四组互不影响</view>
          </view>
        </view>

        <view class="home-action-row">
          <view class="home-action-primary" bindtap="onTryLayeredDemo">
            <view class="home-action-icon">▶</view>
            <view><view class="home-action-title">直接试玩</view><view class="home-action-sub">随机素材，立即体验</view></view>
          </view>
          <view class="home-action-secondary" bindtap="onCreateLayeredDressup">
            <view class="home-action-icon home-action-icon-upload">↑</view>
            <view><view class="home-action-title">上传我的素材</view><view class="home-action-sub">用自己的图片创作</view></view>
          </view>
        </view>
      </block>

      <block wx:if="{{activeHomePlay === 'fun-text-stack'}}">
        <view class="home-preview-head">
          <view>
            <view class="home-preview-title">趣味字画</view>
            <view class="home-preview-sub">先滑完一句话，再决定要不要做自己的</view>
          </view>
          <view class="home-preview-tag home-preview-tag-pink">开发中</view>
        </view>
        <view class="funtext-preview-layout">
          <swiper class="fun-text-demo-swiper" current="{{funTextDemoIndex}}" bindchange="onFunTextDemoChange">
            <swiper-item wx:for="{{funTextDemoSlides}}" wx:key="src" wx:for-item="slide">
              <image class="funtext-preview-image" src="{{slide.src}}" mode="aspectFit" bindtap="onTryFunTextDemo" />
            </swiper-item>
          </swiper>
          <view class="funtext-preview-side">
            <view class="funtext-preview-kicker">滑一下看看</view>
            <view class="funtext-preview-progress">{{funTextDemoIndex + 1}} / {{funTextDemoSlides.length}}</view>
            <view class="funtext-preview-copy">每张只说一点，最后一张才落下真正想说的话。</view>
            <view class="funtext-preview-dots">
              <view class="funtext-preview-dot {{index === funTextDemoIndex ? 'funtext-preview-dot-active' : ''}}" wx:for="{{funTextDemoSlides}}" wx:key="src"></view>
            </view>
          </view>
        </view>
        <view class="home-action-row home-action-row-funtext">
          <view class="home-action-primary home-action-primary-pink" bindtap="onTryFunTextDemo">
            <view class="home-action-icon">▶</view>
            <view><view class="home-action-title">把你的话也变成一叠</view><view class="home-action-sub">先用示例试玩</view></view>
          </view>
          <view class="home-action-secondary home-action-secondary-pink" bindtap="onCreateFunText">
            <view class="home-action-icon home-action-icon-write">✎</view>
            <view><view class="home-action-title">输入我的一句话</view><view class="home-action-sub">生成三套表达</view></view>
          </view>
        </view>
      </block>
    </view>

    <view class="home-tools-head">
      <view class="home-tools-title">更多工具</view>
      <view class="home-tools-side">发现更多有趣玩法 ›</view>
    </view>
    <view class="home-tools-grid">
      <block wx:for="{{homeTools}}" wx:key="key">
        <view class="home-tool-item" wx:if="{{item.status === 'available'}}" bindtap="onChooseMedia">
          <view class="home-tool-icon home-tool-icon-{{item.key}}">{{item.emoji}}</view>
          <view class="home-tool-name">{{item.name}}</view>
          <view class="home-tool-status">可用</view>
        </view>
        <view class="home-tool-item home-tool-item-coming" wx:else bindtap="onComingSoon">
          <view class="home-tool-icon home-tool-icon-{{item.key}}">{{item.emoji}}</view>
          <view class="home-tool-name">{{item.name}}</view>
          <view class="home-tool-status">即将上线</view>
        </view>
      </block>
    </view>
  </block>

  <!-- ===== 步骤二：处理前确认（缩略图 + 输出比例，逻辑原样保留） ===== -->
  <view class="confirm-section" wx:if="{{step === 'confirm'}}">
    <view class="confirm-head-row">
      <view class="confirm-head">已选 {{pickedImages.length}} 张图片</view>
      <view class="confirm-repick" bindtap="onBackToHome">‹ 重新选择</view>
    </view>

    <!-- 已选图片缩略图网格（4 列，白卡容器） -->
    <view class="picked-card">
      <view class="picked-grid">
        <view class="picked-item" wx:for="{{pickedImages}}" wx:key="tempFilePath" bindtap="onPreviewConfirmImage" data-index="{{index}}">
          <image class="picked-img" src="{{item.tempFilePath}}" mode="aspectFill" lazy-load="true" />
          <!-- 单张移除：catchtap 阻止冒泡，避免同时触发预览 -->
          <view class="picked-del" catchtap="onRemoveImage" data-index="{{index}}">×</view>
        </view>
        <!-- 添加图片入口：未满 9 张时显示，点击进入本地相册继续添加 -->
        <view class="picked-add" wx:if="{{pickedImages.length < 9}}" bindtap="onAddMedia">
          <view class="picked-add-plus">＋</view>
          <view class="picked-add-text">添加</view>
        </view>
      </view>
    </view>

    <!-- 输出比例分段控件 -->
    <view class="ratio-label">输出比例（白底卡片）</view>
    <view class="ratio-seg">
      <view
        class="ratio-seg-item {{confirmRatio === item.key ? 'ratio-seg-item-on' : ''}}"
        wx:for="{{ratioOptions}}"
        wx:key="key"
        bindtap="onSelectConfirmRatio"
        data-key="{{item.key}}"
      >{{item.label}}</view>
    </view>
    <view class="ratio-note">比例只影响白底卡片合成，不重新抠图；结果页可随时修改。</view>

    <!-- 开始处理主按钮 -->
    <view class="confirm-cta {{processing ? 'confirm-cta-disabled' : ''}}" bindtap="onStartProcess">
      <view class="btn-grad">{{processing ? '处理中...' : '开始处理'}}</view>
    </view>
    <view class="confirm-hint">若包含人像、风景等非穿搭图片，将自动归入「其他素材」</view>
  </view>

  <!-- 处理中的 Loading 弹窗 -->
  <view class="loading-overlay" wx:if="{{loading}}">
    <view class="loading-box">
      <view class="spinner"></view>
      <view class="loading-text">{{loadingText}}</view>
      <view class="loading-subtext">正在处理您的穿搭素材...</view>
      <view class="loading-cancel" bindtap="onCancelProcess">取消处理</view>
    </view>
  </view>
</view>
