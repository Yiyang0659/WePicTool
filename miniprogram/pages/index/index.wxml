<!--pages/index/index.wxml-->
<view class="container">
  <!-- ===== 步骤一：首页选图入口 ===== -->
  <block wx:if="{{step === 'home'}}">
    <!-- 1. 品牌区 -->
    <view class="brand-section">
      <view class="brand-logo">
        <!-- 叠图堆叠小图标：三张卡片扇形叠放，贴合“微信叠图”定位 -->
        <view class="brand-stack">
          <view class="brand-stack-card brand-stack-back"></view>
          <view class="brand-stack-card brand-stack-mid"></view>
          <view class="brand-stack-card brand-stack-top"></view>
        </view>
      </view>
      <view class="brand-info">
        <view class="brand-name">滑一叠</view>
        <view class="brand-slogan">一叠图，发得好看 · 微信叠图玩法生成器</view>
      </view>
    </view>

    <!-- 2. 四叠真实效果演示 -->
    <view class="layered-demo-card">
      <view class="layered-demo-head">
        <view>
          <view class="layered-demo-title">四个部位独立滑动</view>
          <view class="layered-demo-sub">朋友在微信里随手组合，像玩纸娃娃</view>
        </view>
        <view class="layered-demo-live">玩法演示</view>
      </view>
      <view class="layered-demo-row" wx:for="{{layeredDemoRows}}" wx:key="key" wx:for-item="row">
        <view class="layered-demo-label"><text>{{row.emoji}}</text><text>{{row.name}}</text></view>
        <swiper class="layered-row-swiper" autoplay interval="{{1900 + index * 320}}" circular indicator-dots="false">
          <swiper-item wx:for="{{row.images}}" wx:key="*this" wx:for-item="src">
            <image class="layered-row-image" src="{{src}}" mode="aspectFit" />
          </swiper-item>
        </swiper>
        <view class="layered-stack-edge edge-one"></view>
        <view class="layered-stack-edge edge-two"></view>
      </view>
      <view class="layered-demo-caption">头像、上衣、下装、鞋子各发一叠，四组互不影响</view>
    </view>

    <!-- 3. 旗舰主卡 -->
    <view class="hero-card">
      <view class="hero-icon">🪄</view>
      <view class="hero-eyebrow">本期主玩法</view>
      <view class="hero-title">分层云换装</view>
      <view class="hero-desc">系统模板开箱即玩，也能上传自己的头像、衣服和鞋子，自由混搭成四叠。</view>
      <view class="hero-cta-row">
        <view class="hero-cta" bindtap="onTryLayeredDemo">直接试玩</view>
        <view class="hero-cta-ghost" bindtap="onCreateLayeredDressup">上传自己的素材</view>
      </view>
    </view>

    <!-- 4. 热门模板 -->
    <view class="section-head">
      <view class="section-title-wrap">
        <view class="section-bar"></view>
        <view class="section-title">热门模板</view>
      </view>
      <view class="section-side">首套已可用</view>
    </view>
    <view class="hot-template-card" bindtap="onTryLayeredDemo">
      <view class="hot-template-cover">
        <image class="hot-template-head" src="/assets/samples/head2.png" mode="aspectFit" />
        <view class="hot-template-mini hot-mini-one">👕</view>
        <view class="hot-template-mini hot-mini-two">👟</view>
      </view>
      <view class="hot-template-copy">
        <view class="hot-template-kicker">分层云换装 · 内置素材</view>
        <view class="hot-template-title">抽象搞怪</view>
        <view class="hot-template-desc">4 个部位 × 3 张素材，不选图也能完整体验</view>
      </view>
      <view class="hot-template-arrow">›</view>
    </view>

    <!-- 5. 已有 AI 工具 -->
    <view class="section-head section-head-spaced">
      <view class="section-title-wrap">
        <view class="section-bar"></view>
        <view class="section-title">我的照片工具</view>
      </view>
      <view class="section-side">已有能力</view>
    </view>
    <view class="ai-tool-card">
      <view class="ai-tool-icon">📸</view>
      <view class="ai-tool-copy">
        <view class="ai-tool-title">AI 穿搭整理</view>
        <view class="ai-tool-desc">自动分类、去背、白底卡，适合整理真实衣物照片</view>
      </view>
      <view class="ai-tool-action" bindtap="onChooseMedia">选图</view>
    </view>
    <view class="ai-sample-link" bindtap="onTrySample">没有素材？用原来的 3+3+3 示例试试 →</view>

    <!-- 6. 后续玩法 -->
    <view class="section-head section-head-spaced">
      <view class="section-title-wrap">
        <view class="section-bar"></view>
        <view class="section-title">下一批玩法</view>
      </view>
      <view class="section-side">陆续实现</view>
    </view>
    <view class="module-grid">
      <view class="module-card" wx:for="{{comingModules}}" wx:key="key" bindtap="onComingSoon">
        <view class="module-badge">即将上线</view>
        <view class="module-emoji">{{item.emoji}}</view>
        <view class="module-name">{{item.name}}</view>
        <view class="module-desc">{{item.desc}}</view>
      </view>
    </view>

    <!-- 7. 工具区 -->
    <view class="tool-card" bindtap="onComingSoon">
      <view class="tool-emoji">🗂️</view>
      <view class="tool-info">
        <view class="tool-name">资料打包</view>
        <view class="tool-desc">多图分组成叠，不再刷屏</view>
      </view>
      <view class="tool-badge">即将上线</view>
    </view>

    <!-- 8. 操作说明 -->
    <view class="guide-card">
      <view class="section-title-wrap guide-title-wrap">
        <view class="section-bar"></view>
        <view class="section-title">怎么玩</view>
      </view>
      <view class="guide-list">
        <view class="guide-item">
          <view class="guide-num">1</view>
          <view class="guide-text">先用「抽象搞怪」模板试玩，或者上传自己的头像、上衣、下装和鞋子。</view>
        </view>
        <view class="guide-item">
          <view class="guide-num">2</view>
          <view class="guide-text">每个部位补到 3 张以上；可以删除、调顺序，也可以用系统素材补齐。</view>
        </view>
        <view class="guide-item">
          <view class="guide-num">3</view>
          <view class="guide-text">在微信预览里分别滑动四叠，确认第一张封面和组合效果。</view>
        </view>
        <view class="guide-item">
          <view class="guide-num">4</view>
          <view class="guide-text">按头像、上衣、下装、鞋子的顺序保存并发送，每组勾选「发送后合并展示」。</view>
        </view>
      </view>
    </view>
  </block>

  <!-- ===== 步骤二：处理前确认（缩略图 + 输出比例，逻辑原样保留） ===== -->
  <view class="confirm-section" wx:if="{{step === 'confirm'}}">
    <view class="confirm-head-row">
      <view class="confirm-head">已选 {{pickedImages.length}} 张图片</view>
      <view class="confirm-repick" bindtap="onBackToHome">‹ 重新选择</view>
    </view>

    <!-- 已选图片缩略图网格（4 列，白卡容器） -->
    <view class="picked-card">
      <view class="picked-grid">
        <view class="picked-item" wx:for="{{pickedImages}}" wx:key="tempFilePath" bindtap="onPreviewConfirmImage" data-index="{{index}}">
          <image class="picked-img" src="{{item.tempFilePath}}" mode="aspectFill" lazy-load="true" />
          <!-- 单张移除：catchtap 阻止冒泡，避免同时触发预览 -->
          <view class="picked-del" catchtap="onRemoveImage" data-index="{{index}}">×</view>
        </view>
        <!-- 添加图片入口：未满 9 张时显示，点击进入本地相册继续添加 -->
        <view class="picked-add" wx:if="{{pickedImages.length < 9}}" bindtap="onAddMedia">
          <view class="picked-add-plus">＋</view>
          <view class="picked-add-text">添加</view>
        </view>
      </view>
    </view>

    <!-- 输出比例分段控件 -->
    <view class="ratio-label">输出比例（白底卡片）</view>
    <view class="ratio-seg">
      <view
        class="ratio-seg-item {{confirmRatio === item.key ? 'ratio-seg-item-on' : ''}}"
        wx:for="{{ratioOptions}}"
        wx:key="key"
        bindtap="onSelectConfirmRatio"
        data-key="{{item.key}}"
      >{{item.label}}</view>
    </view>
    <view class="ratio-note">比例只影响白底卡片合成，不重新抠图；结果页可随时修改。</view>

    <!-- 开始处理主按钮 -->
    <view class="confirm-cta {{processing ? 'confirm-cta-disabled' : ''}}" bindtap="onStartProcess">
      <view class="btn-grad">{{processing ? '处理中...' : '开始处理'}}</view>
    </view>
    <view class="confirm-hint">若包含人像、风景等非穿搭图片，将自动归入「其他素材」</view>
  </view>

  <!-- 处理中的 Loading 弹窗 -->
  <view class="loading-overlay" wx:if="{{loading}}">
    <view class="loading-box">
      <view class="spinner"></view>
      <view class="loading-text">{{loadingText}}</view>
      <view class="loading-subtext">正在处理您的穿搭素材...</view>
      <view class="loading-cancel" bindtap="onCancelProcess">取消处理</view>
    </view>
  </view>
</view>
