/* pages/index/index.wxss */
.container {
  display: flex;
  flex-direction: column;
  padding: 24rpx 24rpx 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background-color: #f6f6f8;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* ===== 1. 品牌区 ===== */
.brand-section {
  display: flex;
  align-items: center;
  margin: 16rpx 4rpx 24rpx;
}

.brand-logo {
  width: 96rpx;
  height: 96rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

/* 品牌区叠图小图标：三张卡片扇形叠放 */
.brand-stack {
  position: relative;
  width: 56rpx;
  height: 56rpx;
}

.brand-stack-card {
  position: absolute;
  width: 34rpx;
  height: 42rpx;
  border-radius: 8rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.08);
}

.brand-stack-back {
  left: 2rpx;
  top: 8rpx;
  background-color: #eef3ff;
  transform: rotate(-10deg);
}

.brand-stack-mid {
  left: 11rpx;
  top: 4rpx;
  background-color: #d7e1fc;
  transform: rotate(2deg);
}

.brand-stack-top {
  left: 20rpx;
  top: 10rpx;
  background: linear-gradient(135deg, #4f6bf5, #6a3df0);
  transform: rotate(12deg);
}

.brand-info {
  display: flex;
  flex-direction: column;
}

.brand-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #111111;
  line-height: 1.3;
}

.brand-slogan {
  font-size: 24rpx;
  color: #999999;
  margin-top: 6rpx;
}

/* ===== 2. 朋友视角仿真演示卡：模拟微信聊天 ===== */
.demo-card {
  background-color: #ededed;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.demo-chat-row {
  display: flex;
  align-items: flex-start;
}

/* 左侧头像圆点：低饱和绿，模拟微信好友头像 */
.demo-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: #8fb573;
  margin-right: 16rpx;
  margin-top: 4rpx;
  flex-shrink: 0;
}

/* 右侧聊天气泡，内嵌编号卡轮播 */
.demo-bubble {
  flex: 1;
  min-width: 0;
  background-color: #ffffff;
  border-radius: 8rpx 24rpx 24rpx 24rpx;
  padding: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.demo-swiper {
  width: 100%;
  height: 360rpx;
}

/* 白底编号卡样式：白底 + 圆角 + 序号角标 */
.demo-slide-card {
  position: relative;
  width: 100%;
  height: 100%;
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}

.demo-slide-num {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  z-index: 2;
  background-color: #111111;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

.demo-slide-img {
  width: 100%;
  height: 100%;
  display: block;
}

.demo-caption {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #333333;
  text-align: center;
}

/* ===== 3. 旗舰主卡：穿搭叠图 ===== */
.hero-card {
  background: linear-gradient(135deg, #4f6bf5, #6a3df0);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 28rpx rgba(106, 61, 240, 0.22);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.hero-card:active {
  opacity: 0.92;
}

.hero-icon {
  width: 72rpx;
  height: 72rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.hero-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 10rpx;
}

.hero-cta-row {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: 28rpx;
  gap: 20rpx;
}

/* 主按钮：白胶囊 + 品牌蓝字（示例体验，强调） */
.hero-cta {
  background-color: #ffffff;
  color: #4f6bf5;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 14rpx 36rpx;
}

/* 次按钮：半透明白描边胶囊（选自己的图） */
.hero-cta-ghost {
  background-color: rgba(255, 255, 255, 0.16);
  border: 2rpx solid rgba(255, 255, 255, 0.65);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 999rpx;
  padding: 12rpx 32rpx;
}

.hero-cta:active,
.hero-cta-ghost:active {
  opacity: 0.85;
}

/* ===== 3. 玩法模板区 ===== */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 4rpx 20rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
}

.section-bar {
  width: 4rpx;
  height: 28rpx;
  border-radius: 2rpx;
  background: linear-gradient(135deg, #4f6bf5, #6a3df0);
  margin-right: 14rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #111111;
}

.section-side {
  font-size: 22rpx;
  color: #999999;
}

.module-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.module-card {
  position: relative;
  background-color: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  padding: 28rpx 24rpx;
}

.module-card:active {
  opacity: 0.85;
}

.module-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background-color: #f2f2f4;
  color: #999999;
  font-size: 20rpx;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

.module-emoji {
  font-size: 40rpx;
  line-height: 1.2;
}

.module-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #111111;
  margin-top: 14rpx;
}

.module-desc {
  font-size: 20rpx;
  color: #999999;
  margin-top: 6rpx;
  line-height: 1.4;
}

/* ===== 4. 工具区 ===== */
.tool-card {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.tool-card:active {
  opacity: 0.85;
}

.tool-emoji {
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.tool-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.tool-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #111111;
}

.tool-desc {
  font-size: 22rpx;
  color: #999999;
  margin-top: 4rpx;
}

.tool-badge {
  background-color: #f2f2f4;
  color: #999999;
  font-size: 20rpx;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  flex-shrink: 0;
}

/* ===== 5. 操作说明卡 ===== */
.guide-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  padding: 28rpx 24rpx;
}

.guide-title-wrap {
  margin-bottom: 24rpx;
}

.guide-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.guide-item {
  display: flex;
  align-items: flex-start;
}

.guide-num {
  width: 36rpx;
  height: 36rpx;
  background: linear-gradient(135deg, #4f6bf5, #6a3df0);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  margin-top: 2rpx;
  flex-shrink: 0;
}

.guide-text {
  font-size: 24rpx;
  color: #555555;
  line-height: 1.6;
}

/* ===== 分层换装旗舰首页 ===== */
.layered-demo-card {
  margin-bottom: 24rpx;
  padding: 26rpx;
  border-radius: 26rpx;
  background: #ecebed;
}

.layered-demo-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.layered-demo-title {
  font-size: 29rpx;
  font-weight: 750;
  color: #22212a;
}

.layered-demo-sub {
  margin-top: 5rpx;
  font-size: 21rpx;
  color: #85828c;
}

.layered-demo-live {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  color: #5549d6;
  background: #e0dcff;
}

.layered-demo-row {
  position: relative;
  display: flex;
  align-items: center;
  height: 112rpx;
  margin-top: 12rpx;
  padding: 10rpx 18rpx;
  overflow: hidden;
  border-radius: 18rpx;
  box-sizing: border-box;
  background: #fff;
}

.layered-demo-label {
  width: 178rpx;
  display: flex;
  gap: 10rpx;
  align-items: center;
  font-size: 22rpx;
  color: #484550;
  flex-shrink: 0;
}

.layered-row-swiper {
  position: relative;
  z-index: 3;
  width: 154rpx;
  height: 92rpx;
  margin-left: 20rpx;
  border-radius: 14rpx;
  background: #faf9fc;
}

.layered-row-image {
  width: 100%;
  height: 100%;
  border-radius: 14rpx;
}

.layered-stack-edge {
  position: absolute;
  width: 142rpx;
  height: 80rpx;
  right: 92rpx;
  border: 2rpx solid #ebe9ef;
  border-radius: 14rpx;
  background: #f8f7fa;
}

.edge-one {
  z-index: 2;
  transform: rotate(2deg) translateX(14rpx);
}

.edge-two {
  z-index: 1;
  transform: rotate(-2deg) translateX(28rpx);
}

.layered-demo-caption {
  margin-top: 18rpx;
  text-align: center;
  font-size: 21rpx;
  color: #68656e;
}

.hero-eyebrow {
  display: inline-block;
  margin-bottom: 10rpx;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.18);
}

.hero-desc {
  line-height: 1.55;
}

.hero-cta-row {
  justify-content: flex-start;
}

.hero-cta,
.hero-cta-ghost {
  text-align: center;
  white-space: nowrap;
}

.section-head-spaced {
  margin-top: 32rpx;
}

.hot-template-card,
.ai-tool-card {
  display: flex;
  align-items: center;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.hot-template-card:active,
.ai-tool-card:active {
  opacity: 0.86;
}

.hot-template-cover {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  overflow: hidden;
  border-radius: 22rpx;
  flex-shrink: 0;
  background: #fff8e9;
}

.hot-template-head {
  width: 100%;
  height: 100%;
}

.hot-template-mini {
  position: absolute;
  right: 8rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 12rpx;
  text-align: center;
  line-height: 42rpx;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.hot-mini-one {
  top: 8rpx;
}

.hot-mini-two {
  top: 58rpx;
}

.hot-template-copy,
.ai-tool-copy {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.hot-template-kicker {
  font-size: 19rpx;
  color: #675bd6;
}

.hot-template-title,
.ai-tool-title {
  margin-top: 5rpx;
  font-size: 29rpx;
  font-weight: 700;
  color: #1c1b22;
}

.hot-template-desc,
.ai-tool-desc {
  margin-top: 7rpx;
  font-size: 21rpx;
  line-height: 1.45;
  color: #8c8993;
}

.hot-template-arrow {
  margin-left: 12rpx;
  font-size: 46rpx;
  color: #aaa7b0;
}

.ai-tool-icon {
  width: 86rpx;
  height: 86rpx;
  border-radius: 20rpx;
  text-align: center;
  line-height: 86rpx;
  font-size: 42rpx;
  background: #eef1ff;
}

.ai-tool-action {
  margin-left: 14rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: #fff;
  background: #5b50e5;
}

.ai-sample-link {
  padding: 18rpx 8rpx 0;
  text-align: right;
  font-size: 21rpx;
  color: #6b60d8;
}

/* ===== Loading 浮层 ===== */
.loading-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.loading-box {
  width: 480rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.12);
}

.spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #ececf0;
  border-top-color: #6a3df0;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 28rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #111111;
  margin-bottom: 8rpx;
  text-align: center;
}

.loading-subtext {
  font-size: 22rpx;
  color: #999999;
  text-align: center;
}

.loading-cancel {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: rgba(0,0,0,0.45);
}

/* ===== 处理前确认页 ===== */
.confirm-section {
  width: 100%;
  margin-top: 8rpx;
}

.confirm-head-row {
  display: grid;
  align-items: center;
  grid-template-columns: 112rpx minmax(0, 1fr) 112rpx;
  margin: 4rpx 4rpx 20rpx;
}

.confirm-head {
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #111111;
}

.confirm-back {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 88rpx;
  min-height: 88rpx;
  color: #1c1d22;
  font-size: 54rpx;
  line-height: 1;
}

.confirm-repick {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-height: 88rpx;
  font-size: 24rpx;
  color: #4f6bf5;
  white-space: nowrap;
}

.confirm-head-spacer {
  width: 112rpx;
  min-height: 88rpx;
}

.confirm-purpose-note {
  margin: -10rpx 4rpx 20rpx;
  color: #8b90a6;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

/* 已选图片缩略图网格（4 列，白卡容器） */
.picked-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  padding: 24rpx;
}

.picked-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 360rpx;
  border: 2rpx dashed #ccd0e0;
  border-radius: 20rpx;
  box-sizing: border-box;
  flex-direction: column;
  color: #8d92a5;
  background: #fafaff;
}

.picked-empty:active {
  border-color: #7d82f7;
  background: #f2f3ff;
}

.picked-empty-plus {
  color: #6b72f4;
  font-size: 68rpx;
  font-weight: 300;
  line-height: 1;
}

.picked-empty-title {
  margin-top: 18rpx;
  color: #3b3f59;
  font-size: 28rpx;
  font-weight: 650;
}

.picked-empty-sub {
  margin-top: 10rpx;
  font-size: 21rpx;
}

.picked-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.picked-item {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: #f6f6f8;
}

.picked-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 单张移除角标 */
.picked-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 999rpx;
  background-color: rgba(0, 0, 0, 0.55);
  color: #ffffff;
  font-size: 26rpx;
  line-height: 36rpx;
  text-align: center;
  z-index: 2;
}

/* 添加图片虚线卡片 */
.picked-add {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  border-radius: 16rpx;
  border: 2rpx dashed #cccccc;
  background-color: #fafafa;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.picked-add:active {
  background-color: #f0f0f3;
}

.picked-add-plus {
  font-size: 48rpx;
  color: #999999;
  line-height: 1;
}

.picked-add-text {
  font-size: 20rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 输出比例分段控件 */
.ratio-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
  margin: 32rpx 4rpx 16rpx;
}

.ratio-seg {
  display: flex;
  background-color: #ececf0;
  border-radius: 20rpx;
  padding: 6rpx;
}

.ratio-seg-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  font-weight: 500;
  color: #555555;
  border-radius: 16rpx;
}

.ratio-seg-item-on {
  background-color: #ffffff;
  color: #111111;
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.12);
}

.ratio-note {
  font-size: 22rpx;
  color: #999999;
  margin: 16rpx 4rpx 0;
  line-height: 1.5;
}

/* 开始处理主按钮 */
.confirm-cta {
  margin-top: 36rpx;
}

.confirm-cta-disabled {
  pointer-events: none;
  opacity: 0.55;
}

.btn-grad {
  width: 100%;
  box-sizing: border-box;
  text-align: center;
  border-radius: 20rpx;
  padding: 24rpx 0;
  background: linear-gradient(135deg, #4f6bf5, #6a3df0);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 28rpx rgba(106, 61, 240, 0.22);
}

.btn-grad:active {
  opacity: 0.88;
}

.confirm-hint {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #999999;
  text-align: center;
  line-height: 1.5;
}

/* ===== 趣味字画真实示例（开发中） ===== */
.fun-text-demo-card {
  margin-bottom: 24rpx;
  padding: 26rpx;
  border-radius: 26rpx;
  background: linear-gradient(160deg, #fff0f5, #ffe9ef);
  border: 2rpx solid #ffd3e2;
}

.fun-text-demo-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.fun-text-demo-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.fun-text-demo-title {
  font-size: 29rpx;
  font-weight: 750;
  color: #26211f;
}

.fun-text-demo-badge {
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  color: #e0447c;
  background: #ffffff;
  border: 2rpx solid #ffc9dd;
}

.fun-text-demo-sub {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #8a7f7b;
}

.fun-text-demo-tip {
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #e0447c;
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(243, 92, 140, 0.14);
  flex-shrink: 0;
}

.fun-text-demo-swiper {
  width: 100%;
  height: 640rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: #ffffff;
}

.fun-text-demo-image {
  width: 100%;
  height: 100%;
}

.fun-text-demo-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  min-height: 56rpx;
}

.fun-text-demo-indicator {
  font-size: 22rpx;
  color: #b08f9c;
  font-variant-numeric: tabular-nums;
}

.fun-text-demo-hint {
  font-size: 22rpx;
  color: #b08f9c;
}

.fun-text-demo-cta {
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #f35c8c, #f07856);
  box-shadow: 0 10rpx 22rpx rgba(243, 92, 140, 0.28);
}

.fun-text-demo-cta:active {
  opacity: 0.88;
}

/* ===== 2026-09-05 首页双玩法共享预览 ===== */
.container {
  padding: 22rpx 24rpx 44rpx;
  background: #f7f8fc;
}

.home-question {
  margin: 10rpx 4rpx 20rpx;
  color: #151728;
  font-size: 42rpx;
  font-weight: 750;
  line-height: 1.2;
  letter-spacing: -1rpx;
}

.home-play-switch {
  display: flex;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.home-play-option {
  position: relative;
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  height: 112rpx;
  padding: 16rpx 18rpx;
  border: 2rpx solid transparent;
  border-radius: 24rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 8rpx 26rpx rgba(57, 63, 101, 0.05);
}

.home-play-option-active.home-play-layered {
  border-color: #aeb5ff;
  background: linear-gradient(145deg, #f8f9ff, #eef0ff);
  box-shadow: 0 10rpx 30rpx rgba(102, 112, 246, 0.12);
}

.home-play-option-active.home-play-funtext {
  border-color: #f4b5dc;
  background: linear-gradient(145deg, #fffafd, #fff0f8);
  box-shadow: 0 10rpx 30rpx rgba(237, 101, 181, 0.1);
}

.home-play-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  margin-right: 14rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  font-size: 34rpx;
}

.home-play-icon-layered {
  background: #eef0ff;
}

.home-play-icon-funtext {
  color: #ed65b5;
  background: #fff0f8;
}

.home-play-copy {
  min-width: 0;
  flex: 1;
}

.home-play-title {
  color: #151728;
  font-size: 27rpx;
  font-weight: 700;
  white-space: nowrap;
}

.home-play-desc {
  margin-top: 6rpx;
  overflow: hidden;
  color: #8b90a6;
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-play-check {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #6670f6;
  font-size: 22rpx;
  font-weight: 700;
}

.home-play-check-pink {
  background: #ed65b5;
}

.home-shared-preview {
  min-height: 650rpx;
  padding: 24rpx;
  border-radius: 30rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(57, 63, 101, 0.07);
}

.home-preview-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  min-height: 72rpx;
  margin-bottom: 18rpx;
}

.home-preview-title {
  color: #151728;
  font-size: 32rpx;
  font-weight: 750;
}

.home-preview-sub {
  margin-top: 5rpx;
  color: #8b90a6;
  font-size: 19rpx;
  line-height: 1.35;
}

.home-preview-tag {
  margin-left: 14rpx;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  color: #6670f6;
  background: #eef0ff;
  font-size: 18rpx;
}

.home-preview-tag-pink {
  color: #d94d9e;
  background: #fff0f8;
}

.layered-preview-layout {
  display: flex;
  align-items: stretch;
  gap: 14rpx;
}

.layered-choice-list {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 10rpx;
}

.layered-choice-row {
  display: flex;
  align-items: center;
  min-height: 126rpx;
  padding: 10rpx;
  border-radius: 18rpx;
  box-sizing: border-box;
  background: #fafaff;
}

.layered-choice-meta {
  width: 108rpx;
  flex-shrink: 0;
}

.layered-choice-name {
  display: flex;
  align-items: center;
  gap: 5rpx;
  color: #272a3b;
  font-size: 18rpx;
  font-weight: 600;
  white-space: nowrap;
}

.layered-choice-count {
  margin-top: 5rpx;
  padding-left: 28rpx;
  color: #9a9fb3;
  font-size: 16rpx;
  font-variant-numeric: tabular-nums;
}

.layered-choice-controls {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

.layered-choice-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 88rpx;
  flex-shrink: 0;
  color: #7c829c;
  font-size: 38rpx;
}

.layered-single-swiper {
  min-width: 0;
  height: 104rpx;
  flex: 1;
}

.layered-single-frame {
  width: 100%;
  height: 100%;
  overflow: hidden;
  border: 3rpx solid #6670f6;
  border-radius: 18rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 5rpx 14rpx rgba(102, 112, 246, 0.16);
}

.layered-single-image {
  display: block;
  width: 100%;
  height: 100%;
}

.layered-current-panel {
  display: flex;
  width: 188rpx;
  padding: 14rpx 12rpx;
  border: 2rpx solid #eef0ff;
  border-radius: 22rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  flex-direction: column;
  background: linear-gradient(160deg, #f5f7ff, #eef1ff);
}

.layered-current-title {
  color: #5e65c8;
  font-size: 18rpx;
  font-weight: 600;
  text-align: center;
}

.layered-current-list {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  margin: 12rpx 0;
  flex-direction: column;
}

.layered-current-item {
  display: flex;
  align-items: center;
  width: 100%;
  flex: 1;
  flex-direction: column;
}

.layered-current-label {
  overflow: hidden;
  width: 100%;
  color: #777da1;
  font-size: 15rpx;
  line-height: 1.25;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.layered-current-cell {
  width: 116rpx;
  height: 80rpx;
  margin-top: 4rpx;
  overflow: hidden;
  border-radius: 13rpx;
  background: rgba(255, 255, 255, 0.8);
}

.layered-current-cell image {
  width: 100%;
  height: 100%;
}

.layered-current-note {
  color: #7f85aa;
  font-size: 16rpx;
  text-align: center;
}

.home-action-row {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
}

.home-action-primary,
.home-action-secondary {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  height: 104rpx;
  padding: 14rpx 18rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.home-action-primary {
  color: #ffffff;
  background: linear-gradient(135deg, #8980ff, #6470f7);
  box-shadow: 0 12rpx 26rpx rgba(102, 112, 246, 0.24);
}

.home-action-secondary {
  border: 2rpx solid #d9ddff;
  color: #26294b;
  background: #ffffff;
}

.home-action-primary-pink {
  background: linear-gradient(135deg, #f180be, #ed65a1);
  box-shadow: 0 12rpx 26rpx rgba(237, 101, 181, 0.22);
}

.home-action-secondary-pink {
  border-color: #f4c4df;
}

.home-action-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  margin-right: 13rpx;
  border-radius: 50%;
  flex-shrink: 0;
  color: #6670f6;
  background: #ffffff;
  font-size: 22rpx;
}

.home-action-icon-upload,
.home-action-icon-write {
  color: #ffffff;
  background: linear-gradient(135deg, #9b66ee, #6670f6);
}

.home-action-icon-write {
  background: linear-gradient(135deg, #f180be, #ed65a1);
}

.home-action-title {
  overflow: hidden;
  font-size: 24rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-action-sub {
  margin-top: 3rpx;
  overflow: hidden;
  color: inherit;
  font-size: 17rpx;
  opacity: 0.72;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.funtext-preview-layout {
  display: flex;
  align-items: stretch;
  min-height: 388rpx;
  padding: 12rpx;
  border-radius: 22rpx;
  box-sizing: border-box;
  background: linear-gradient(150deg, #fff5fa, #fff0f7);
}

.fun-text-demo-swiper {
  width: 366rpx;
  height: 366rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
  background: #ffffff;
}

.funtext-preview-image {
  width: 100%;
  height: 100%;
  border-radius: 18rpx;
}

.funtext-preview-side {
  display: flex;
  min-width: 0;
  padding: 22rpx 12rpx 18rpx 22rpx;
  flex: 1;
  flex-direction: column;
}

.funtext-preview-kicker {
  color: #d94d9e;
  font-size: 21rpx;
  font-weight: 700;
}

.funtext-preview-progress {
  margin-top: 14rpx;
  color: #ed65b5;
  font-size: 36rpx;
  font-weight: 750;
  font-variant-numeric: tabular-nums;
}

.funtext-preview-copy {
  margin-top: 16rpx;
  color: #817485;
  font-size: 19rpx;
  line-height: 1.55;
}

.funtext-preview-dots {
  display: flex;
  gap: 8rpx;
  margin-top: auto;
}

.funtext-preview-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #e6d3df;
}

.funtext-preview-dot-active {
  width: 24rpx;
  border-radius: 999rpx;
  background: #ed65b5;
}

.home-tools-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 6rpx 16rpx;
}

.home-tools-title {
  color: #151728;
  font-size: 30rpx;
  font-weight: 720;
}

.home-tools-side {
  color: #969bae;
  font-size: 20rpx;
}

.home-tools-grid {
  display: flex;
  gap: 12rpx;
}

.home-tool-item {
  position: relative;
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  padding: 18rpx 7rpx 14rpx;
  border-radius: 22rpx;
  box-sizing: border-box;
  flex-direction: column;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(57, 63, 101, 0.05);
}

.home-tool-item-coming {
  opacity: 0.72;
}

.home-tool-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border-radius: 20rpx;
  color: #6670f6;
  background: #eef0ff;
  font-size: 28rpx;
}

.home-tool-icon-film {
  color: #2fac80;
  background: #eaf9f2;
}

.home-tool-icon-beforeafter {
  color: #e98143;
  background: #fff1e8;
}

.home-tool-icon-more {
  color: #7f879f;
  background: #eff1f6;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.home-tool-name {
  margin-top: 10rpx;
  overflow: hidden;
  color: #292c3e;
  font-size: 19rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-tool-status {
  margin-top: 5rpx;
  color: #9a9fb0;
  font-size: 15rpx;
}

.home-tool-item:first-child .home-tool-status {
  color: #6670f6;
}

.home-play-option:active,
.layered-single-frame:active,
.layered-choice-arrow:active,
.home-action-primary:active,
.home-action-secondary:active,
.home-tool-item:active {
  opacity: 0.82;
}

@media (max-width: 350px) {
  .home-play-desc,
  .home-action-sub,
  .home-preview-tag {
    display: none;
  }

  .home-play-icon {
    width: 58rpx;
    height: 58rpx;
    margin-right: 9rpx;
  }

  .layered-current-panel {
    width: 152rpx;
  }

  .layered-choice-meta {
    width: 94rpx;
  }

  .layered-choice-name {
    font-size: 16rpx;
  }

  .layered-choice-count {
    padding-left: 22rpx;
  }

  .layered-choice-arrow {
    width: 28rpx;
  }

  .layered-current-cell {
    width: 100rpx;
  }
}
