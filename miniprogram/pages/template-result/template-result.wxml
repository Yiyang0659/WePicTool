<!-- pages/template-result/template-result.wxml -->
<view class="result-page">
  <view class="result-header">
    <view class="result-title">{{!funTextEntryEnabled ? '趣味字画暂不可用' : (renderFailed ? '暂未准备好预览' : (rendering ? '正在准备预览' : '趣味字画预览'))}}</view>
    <view class="result-source" wx:if="{{project.sourceText}}">“{{project.sourceText}}”</view>
  </view>

  <!-- 渲染加载中 -->
  <view wx:if="{{rendering}}" class="render-loading-box">
    <view class="loading-spinner"></view>
    <view class="loading-text">正在本机准备预览，不提交审核...</view>
  </view>

  <!-- 渲染失败重试 -->
  <view wx:elif="{{renderFailed}}" class="render-failed-box">
    <view class="failed-text">{{renderErrorMessage || '生成失败，请重试'}}</view>
    <button wx:if="{{funTextEntryEnabled}}" class="btn-retry-render" bindtap="onRetryRender">重新生成</button>
    <button wx:if="{{funTextEntryEnabled && project}}" class="btn-edit-again" bindtap="onEditStack">返回编辑，内容已保留</button>
  </view>

  <!-- 渲染成功卡片展示 -->
  <view wx:else class="result-content">
    <view class="stage-container">
      <view class="stage-step-tag">{{currentIndex + 1}} / {{renderedCards.length}}</view>
      <swiper class="result-swiper" current="{{currentIndex}}" bindchange="onSwiperChange">
        <swiper-item wx:for="{{renderedCards}}" wx:key="sceneId" class="result-swiper-item">
          <image class="rendered-card-img" src="{{item.exportUrl || item.url}}" mode="aspectFit" />
        </swiper-item>
      </swiper>
    </view>

    <!-- 底部操作按钮 -->
    <view class="result-actions">
      <button class="btn-preview-dark" bindtap="onPreviewStack">先滑着看看</button>
      <button class="btn-edit-again" bindtap="onEditStack">自己改改</button>
      <button class="btn-save-stack" bindtap="onSaveStack" loading="{{saving || exportPreparing}}">
        {{saveCursor > 0 ? ('从 ' + saveNextSequenceLabel + ' 继续保存') : (exportPreparing ? '正在添加顺序号…' : '按顺序保存')}}
      </button>
    </view>
  </view>

  <!-- 保存后四步发送引导浮层 -->
  <view wx:if="{{showGuide}}" class="guide-mask" catchtouchmove="true">
    <view class="guide-dialog">
      <view class="guide-title">已按顺序保存到相册</view>
      <view class="guide-sub">请按以下步骤在微信中发送：</view>

      <view class="guide-steps">
        <view class="guide-step-item">
          <view class="step-num">1</view>
          <view class="step-content">
            <view class="step-bold">每次只发送一叠</view>
            <view class="step-desc">打开你想发送的好友或群聊对话框</view>
          </view>
        </view>

        <view class="guide-step-item">
          <view class="step-num">2</view>
          <view class="step-content">
            <view class="step-bold">按图片角标 01…勾选</view>
            <view class="step-desc">在微信相册中依次勾选这一叠的全部卡片</view>
          </view>
        </view>

        <view class="guide-step-item">
          <view class="step-num">3</view>
          <view class="step-content">
            <view class="step-bold">确认 01 在第一位</view>
            <view class="step-desc">发送前检查选图顺序，避免叠图封面错位</view>
          </view>
        </view>

        <view class="guide-step-item">
          <view class="step-num">4</view>
          <view class="step-content">
            <view class="step-bold">勾选「发送后合并展示」</view>
            <view class="step-desc">再点击发送，朋友点开即可滑着看你的心意</view>
          </view>
        </view>
      </view>

      <button class="btn-guide-close" bindtap="onCloseGuide">我知道了</button>
      <button class="btn-guide-close" bindtap="onGoWechat">去微信发送</button>
    </view>
  </view>

  <!-- 本地高清渲染隐藏画布 -->
  <canvas id="funTextExporterCanvas" type="2d" style="position: fixed; left: -9999px; top: -9999px; width: 1080px; height: 1080px;"></canvas>
  <!-- 独立顺序角标画布，避免与本地应急渲染并发污染 -->
  <canvas id="funTextSequenceBadgeCanvas" type="2d" style="position: fixed; left: -9999px; top: -9999px; width: 1px; height: 1px;"></canvas>
</view>
