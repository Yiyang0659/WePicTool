.import-page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(56rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  color: #151728;
  background: #f7f8fc;
}

.purpose-card {
  padding: 28rpx;
  border-radius: 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #6670f6, #7440e8);
  box-shadow: 0 12rpx 28rpx rgba(102, 112, 246, 0.18);
}

.purpose-badge {
  display: inline-flex;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  background: rgba(255, 255, 255, 0.18);
}

.purpose-title {
  margin-top: 22rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.purpose-desc {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.6;
  opacity: 0.9;
}

.section-head,
.review-group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-head {
  margin: 28rpx 4rpx 16rpx;
}

.section-title,
.review-title {
  font-size: 30rpx;
  font-weight: 700;
}

.reset-link {
  min-height: 60rpx;
  color: #6670f6;
  font-size: 23rpx;
  line-height: 60rpx;
}

.picked-card,
.review-group {
  padding: 22rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(57, 63, 101, 0.05);
}

.picked-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 340rpx;
  border: 2rpx dashed #ccd0e0;
  border-radius: 20rpx;
  flex-direction: column;
  color: #8b90a6;
  background: #fafaff;
}

.picked-empty-plus,
.picked-add-plus {
  color: #6670f6;
  font-size: 60rpx;
  line-height: 1;
}

.picked-empty-title {
  margin-top: 18rpx;
  color: #34374b;
  font-size: 28rpx;
  font-weight: 650;
}

.picked-empty-sub {
  margin-top: 9rpx;
  font-size: 22rpx;
}

.picked-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14rpx;
}

.picked-item,
.picked-add {
  position: relative;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 16rpx;
  background: #f5f5f8;
}

.picked-img {
  width: 100%;
  height: 100%;
}

.picked-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  color: #fff;
  background: rgba(25, 25, 30, 0.72);
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.picked-add {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #ccd0e0;
  box-sizing: border-box;
  flex-direction: column;
  color: #8b90a6;
  font-size: 20rpx;
}

.picked-add-plus {
  font-size: 42rpx;
}

.ratio-title {
  margin: 28rpx 4rpx 14rpx;
  font-size: 26rpx;
  font-weight: 650;
}

.ratio-seg {
  display: flex;
  padding: 6rpx;
  border-radius: 20rpx;
  background: #ececf3;
}

.ratio-item {
  flex: 1;
  height: 76rpx;
  border-radius: 16rpx;
  color: #5d6070;
  font-size: 25rpx;
  line-height: 76rpx;
  text-align: center;
}

.ratio-item-active {
  color: #151728;
  background: #fff;
  box-shadow: 0 3rpx 10rpx rgba(57, 63, 101, 0.1);
  font-weight: 700;
}

.ratio-note,
.review-sub {
  margin-top: 10rpx;
  color: #8b90a6;
  font-size: 21rpx;
  line-height: 1.5;
}

.primary-button,
.secondary-button {
  min-height: 88rpx;
  margin-top: 24rpx;
  border-radius: 20rpx;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 88rpx;
  text-align: center;
}

.primary-button {
  color: #fff;
  background: linear-gradient(135deg, #6670f6, #7440e8);
}

.secondary-button {
  border: 2rpx solid #d9ddff;
  color: #5b55d9;
  background: #fff;
}

.button-disabled {
  opacity: 0.38;
}

.review-head {
  padding: 8rpx 4rpx 0;
}

.review-summary {
  margin: 20rpx 0;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  color: #5e65c8;
  background: #eef0ff;
  font-size: 22rpx;
}

.review-group {
  margin-top: 18rpx;
}

.review-group-title {
  font-size: 25rpx;
  font-weight: 700;
}

.review-group-count {
  color: #8b90a6;
  font-size: 21rpx;
}

.review-scroll {
  margin-top: 16rpx;
  white-space: nowrap;
}

.review-row {
  display: inline-flex;
  gap: 14rpx;
}

.review-item {
  position: relative;
  display: inline-flex;
  width: 190rpx;
  padding: 10rpx;
  border-radius: 18rpx;
  box-sizing: border-box;
  flex-direction: column;
  background: #fafaff;
}

.review-image {
  width: 170rpx;
  height: 170rpx;
  border-radius: 14rpx;
  background: #fff;
}

.review-badge {
  position: absolute;
  top: 18rpx;
  left: 18rpx;
  padding: 5rpx 9rpx;
  border-radius: 999rpx;
  color: #996a00;
  background: #fff0bb;
  font-size: 17rpx;
}

.review-actions {
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
  margin-top: 10rpx;
  color: #5b55d9;
  font-size: 19rpx;
}

.review-delete {
  color: #e5484d;
}

.review-actions-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

.loading-overlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(21, 23, 40, 0.48);
}

.loading-box {
  max-height: 90vh;
  overflow-y: auto;
  width: 100%;
  padding: 40rpx 30rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
  text-align: center;
  background: #fff;
}

.spinner {
  width: 54rpx;
  height: 54rpx;
  margin: 0 auto;
  border: 6rpx solid #e4e6ff;
  border-top-color: #6670f6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-title {
  margin-top: 22rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.loading-desc {
  margin-top: 10rpx;
  color: #8b90a6;
  font-size: 21rpx;
}

.loading-cancel {
  min-height: 88rpx;
  margin-top: 22rpx;
  color: #6670f6;
  line-height: 88rpx;
}

.progress-count { margin-top: 24rpx; color: #6670f6; font-size: 40rpx; font-weight: 700; }
.progress-track { height: 12rpx; background: #ececf0; border-radius: 999rpx; overflow: hidden; margin-top: 16rpx; }
.progress-fill { height: 100%; background: #6670f6; transition: width 200ms ease; }
.progress-list { height: 28vh; margin-top: 16rpx; }
.progress-row { display: flex; align-items: center; gap: 16rpx; padding: 8rpx 0; text-align: left; }
.progress-thumb { width: 64rpx; height: 64rpx; border-radius: 12rpx; flex-shrink: 0; }
.progress-detail { flex: 1; min-width: 0; }
.progress-state { font-size: 24rpx; color: #8b90a6; }
.state-done { color: #07a350; }
.state-processing { color: #6670f6; }
.state-failed, .progress-error { color: #e5484d; }
.progress-error { font-size: 22rpx; line-height: 1.4; }
