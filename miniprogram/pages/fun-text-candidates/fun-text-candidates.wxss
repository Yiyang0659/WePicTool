/* pages/fun-text-candidates/fun-text-candidates.wxss */
.candidates-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 24rpx 100rpx;
  background: #fff8f9;
}

.candidates-header {
  margin-bottom: 28rpx;
  text-align: center;
}

.candidates-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #26211f;
}

.candidates-source {
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #e0447c;
}

.candidates-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a7f7b;
}

.preview-error-banner {
  background: #fff0f3;
  border: 2rpx solid #ffd3e2;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.preview-error-text {
  font-size: 24rpx;
  color: #e5484d;
  font-weight: 500;
}

.candidates-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.candidate-card {
  background: #ffffff;
  border: 2rpx solid #ffd3e2;
  border-radius: 28rpx;
  padding: 24rpx 20rpx;
  box-shadow: 0 10rpx 28rpx rgba(243, 92, 140, 0.08);
}

.candidate-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.candidate-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.candidate-tag {
  font-size: 20rpx;
  color: #f35c8c;
  background: #ffe3ec;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  font-weight: 600;
}

.candidate-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #26211f;
}

.candidate-step {
  font-size: 24rpx;
  font-weight: 600;
  color: #8a7f7b;
}

.candidate-stage {
  width: 600rpx;
  height: 600rpx;
  margin: 0 auto;
  border-radius: 20rpx;
  overflow: hidden;
  background: #fdf6f7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.candidate-swiper {
  width: 600rpx;
  height: 600rpx;
}

.swiper-card-item {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-preview-image {
  width: 600rpx;
  height: 600rpx;
  border-radius: 16rpx;
}

.card-empty-slot {
  width: 600rpx;
  height: 600rpx;
  background: #fdf6f7;
}

.candidate-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.btn-use {
  flex: 3;
  background: linear-gradient(135deg, #f35c8c, #f07856);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 18rpx 0;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(243, 92, 140, 0.24);
}

.btn-edit {
  flex: 2;
  background: #ffffff;
  color: #6d625e;
  border: 2rpx solid #e2d3d0;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 999rpx;
  padding: 18rpx 0;
}

.candidates-footer {
  margin-top: 40rpx;
  padding: 0 16rpx;
}

.btn-regenerate {
  background: #ffffff;
  border: 2rpx solid #ffd3e2;
  color: #e0447c;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 24rpx 0;
  box-shadow: 0 6rpx 16rpx rgba(243, 92, 140, 0.12);
}
