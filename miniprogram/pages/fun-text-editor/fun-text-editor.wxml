<!-- pages/fun-text-editor/fun-text-editor.wxml -->
<view class="editor-page">
  <view class="editor-topbar">
    <view class="history-action {{canUndo ? '' : 'history-action-disabled'}}" bindtap="onUndo">↶ 撤销</view>
    <view class="editor-card-status">第 {{currentCardIndex + 1}} / {{scenes.length}} 张</view>
    <view class="history-action {{canRedo ? '' : 'history-action-disabled'}}" bindtap="onRedo">重做 ↷</view>
  </view>

  <view class="editor-stage {{cardSlideClass}}" wx:if="{{!handwritingVisible && !imageViewerVisible}}" bindtouchstart="onStageTouchStart" bindtouchend="onStageTouchEnd" bindtouchcancel="onStageTouchCancel">
    <!-- Native canvases must be unmounted while the ordinary-view progress dialog is visible. -->
    <fun-live-preview class="local-editor-preview" wx:if="{{localEditorEnabled && currentScene && !editingTextModalVisible && !exportProgress.visible}}"
      scene="{{currentScene}}" project-id="{{project.projectId}}" candidate-id="{{selectedCandidate.candidateId}}"
      drawing="{{drawingMode && activeEditorTab === 'decoration'}}" brush-key="{{brushKey}}" color-key="{{inkColor}}" pen-width="{{penWidth}}"
      bindinkchange="onInkChange" bindinklimit="onInkLimit"
      bindgeometry="onPreviewGeometry" bindtap="onPreviewTap" bindbrowsestart="onStageTouchStart" bindbrowseend="onStageTouchEnd" bindbrowsecancel="onStageTouchCancel" />
    <image
      wx:elif="{{currentFallbackImage && !editingTextModalVisible}}"
      class="editor-stage-fallback"
      bindtap="onPreviewTap"
      src="{{currentFallbackImage}}"
      mode="aspectFit"
    />
    <fun-card-canvas
      wx:elif="{{!localEditorEnabled && currentScene && !editingTextModalVisible && !exportProgress.visible}}"
      scene="{{currentScene}}"
      size="{{320}}"
      revision="{{canvasRevision}}"
      bindfontunavailable="onFontUnavailable"
      bindrendererror="onFontUnavailable"
      bindtap="onPreviewTap"
    />
    <view wx:if="{{serverPreviewLoading && !currentFallbackImage && !editingTextModalVisible}}" class="editor-preview-status">
      <view class="editor-preview-status-title">正在恢复手写预览…</view>
      <view class="editor-preview-status-text">你的文字和编辑不会丢失</view>
    </view>
    <view wx:if="{{serverPreviewFailed && !currentFallbackImage && !editingTextModalVisible}}" class="editor-preview-status editor-preview-status-error">
      <view class="editor-preview-status-title">手写预览暂时没连上</view>
      <view class="editor-preview-status-text">你的文字和编辑已保留</view>
      <button class="editor-preview-retry" bindtap="onRetryEditorPreview">重新加载</button>
    </view>
    <view wx:if="{{activeEditorTab === 'decoration' && !drawingMode && !editingTextModalVisible}}" class="decoration-overlay">
      <view
        wx:for="{{decorationHandles}}"
        wx:key="id"
        class="decoration-handle {{item.selected ? 'decoration-handle-selected' : ''}}"
        style="left: {{item.leftPercent}}%; top: {{item.topPercent}}%; width: {{item.size}}px; height: {{item.size}}px; color: {{localEditorEnabled ? 'transparent' : item.color}}; transform: translate(-50%, -50%) rotate({{item.rotation}}deg);"
        data-layer-id="{{item.id}}"
        bindtap="onSelectDecoration"
        catchtouchstart="onDecorationTouchStart"
        catchtouchmove="onDecorationTouchMove"
        catchtouchend="onDecorationTouchEnd"
        catchtouchcancel="onDecorationTouchEnd"
      >{{item.label}}</view>
    </view>
    <view wx:if="{{(activeEditorTab === 'decoration' || activeEditorTab === 'content') && !editingTextModalVisible && !exportProgress.visible}}" class="ink-sticker-overlay">
      <view wx:for="{{currentScene.inkStickers}}" wx:key="id" data-id="{{item.id}}"
        class="ink-sticker-handle {{selectedInkId === item.id ? 'ink-sticker-selected' : ''}}"
        style="left:{{item.x / 10.8}}%;top:{{item.y / 10.8}}%;width:{{item.scale * 100}}%;height:{{item.scale * 100}}%;transform:translate(-50%,-50%) rotate({{item.rotation}}deg);"
        catchtap="onSelectInkSticker" catchtouchstart="onInkStickerStart" catchtouchmove="onInkStickerMove" catchtouchend="onInkStickerEnd" catchtouchcancel="onInkStickerCancel">
        <text wx:if="{{selectedInkId === item.id}}" class="ink-sticker-label">手写贴纸 · 拖动 / 双指调整</text>
      </view>
    </view>
  </view>

  <view class="editor-save-actions"><button class="editor-secondary" disabled="{{editorExportBusy}}" bindtap="onSaveCurrentPage">↓ 保存当前页</button><button class="editor-primary" disabled="{{editorExportBusy}}" bindtap="onSaveAllPages">保存整组图片</button></view>

  <view class="editor-section cards-section">
    <view class="section-header compact-header">
      <text class="section-title">卡片顺序</text>
      <text class="section-hint">左右滑动查看，首张是微信封面</text>
      <button wx:if="{{localEditorEnabled}}" class="add-blank-card" disabled="{{scenes.length >= 8 || editorExportBusy}}" bindtap="onAddBlankCard">＋空白卡</button>
    </view>
    <view wx:if="{{scenes.length >= 8}}" class="section-hint">已达8张上限，删除一张后可添加新卡</view>
    <scroll-view class="cards-scroll" scroll-x="true">
      <view class="cards-movable-area" style="width: {{sortAreaWidth}}px; height: {{sortItemWidth * 4 / 3 + 6}}px;">
        <view
          wx:for="{{sortItems}}"
          wx:key="sceneId"
          class="card-thumb-movable"
          style="width: {{sortItemWidth}}px; transform: translateX({{item.x}}px);"
        >
          <view
            class="card-thumb-item {{item.previewPatternClass}} {{index === currentCardIndex ? 'thumb-active' : ''}} {{index === draggingIndex ? 'thumb-dragging' : ''}} {{item.isDropTarget ? 'thumb-drop-target' : ''}}"
            style="background-color: {{item.previewBackground}}; height: {{sortItemWidth}}px;"
            data-index="{{index}}"
            bindtap="onSelectCard"
          >
            <view class="thumb-badge {{index === 0 ? 'badge-cover' : ''}}">{{item.label}}</view>
            <view class="thumb-decorations" style="color: {{item.previewDecorationColor}};">{{item.previewDecorations}}</view>
            <view class="thumb-text" style="color: {{item.previewTextColor}};">{{item.previewText}}</view>
          </view>
          <view class="card-order-actions">
            <button disabled="{{index === 0 || editorExportBusy}}" data-index="{{index}}" data-delta="-1" catchtap="onMoveCard" aria-label="前移">←</button>
            <button disabled="{{index === sortItems.length - 1 || editorExportBusy}}" data-index="{{index}}" data-delta="1" catchtap="onMoveCard" aria-label="后移">→</button>
            <button class="card-delete" disabled="{{sortItems.length <= 1 || editorExportBusy}}" data-index="{{index}}" catchtap="onDeleteCard" aria-label="删除">删</button>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="editor-tabs">
    <view
      wx:for="{{editorTabs}}"
      wx:key="key"
      class="editor-tab {{activeEditorTab === item.key ? 'editor-tab-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onSelectEditorTab"
    >{{item.label}}</view>
  </view>

  <view wx:if="{{activeEditorTab === 'content'}}" class="editor-panel">
    <view class="section-header">
      <text class="section-title">文字内容</text>
      <text class="section-hint">只修改当前卡</text>
    </view>
    <view class="edit-text-row" bindtap="onEditText">
      <view class="edit-text-preview">{{currentText ? currentText : '（纯涂鸦卡，点此添加文字）'}}</view>
      <view class="edit-text-action">改文字</view>
    </view>
    <view wx:if="{{localEditorEnabled}}" class="handwriting-card content-handwriting">
      <view class="handwriting-heading">
        <view class="pen-tile"><view class="pen-icon"></view></view>
        <view class="handwriting-intro"><view class="handwriting-title">自由手写 <text class="help-icon" bindtap="onHandwritingHelp">?</text></view><text class="handwriting-subtitle">加到当前卡，或配背景做成新卡</text></view>
        <button class="handwriting-start" hover-class="button-pressed" disabled="{{editorExportBusy}}" bindtap="onStartHandwriting">开始手写 →</button>
      </view>
      <view class="draft-library">
        <view class="draft-heading"><text class="draft-title">◷ 最近本机草稿</text><view class="draft-actions"><text>仅保存在本机</text><text class="draft-clear" bindtap="onClearHandwritingDrafts">清空</text></view></view>
        <scroll-view scroll-x="true" enable-flex class="draft-scroll">
          <view class="draft-row">
            <view class="draft-tile draft-new" hover-class="button-pressed" bindtap="onStartHandwriting"><text class="draft-plus">＋</text><text>新建手写</text></view>
            <view wx:for="{{handwritingDrafts}}" wx:key="id" class="draft-tile" data-id="{{item.id}}" bindtap="onStartHandwriting" bindlongpress="onDeleteHandwritingDraft" hover-class="button-pressed">
              <view class="draft-image"><fun-live-preview wx:if="{{!handwritingVisible && !exportProgress.visible}}" local-only="{{true}}" scene="{{item.scene}}" /></view><text class="draft-date">{{item.timeLabel}}</text>
            </view>
            <view wx:if="{{!handwritingDrafts.length}}" class="draft-empty">你的手写作品会显示在这里<text>点击新建，写下第一笔</text></view>
          </view>
        </scroll-view>
      </view>
      <view wx:if="{{selectedInkId}}" class="ink-options"><button bindtap="onEditInkSticker">继续编辑手写</button><button bindtap="onDeleteInkSticker">删除此手写</button></view>
      <view wx:if="{{handwritingStatus && !handwritingVisible}}" class="handwriting-save-status">{{handwritingStatus}}</view>
    </view>
    <view class="control-label">字号</view>
    <view class="size-options">
      <view class="size-chip" data-preset="small" bindtap="onSetTextSize">小</view>
      <view class="size-chip" data-preset="standard" bindtap="onSetTextSize">标准</view>
      <view class="size-chip" data-preset="large" bindtap="onSetTextSize">大</view>
    </view>
    <view class="restore-row">
      <view class="restore-action" bindtap="onRestoreCard">恢复当前卡</view>
      <view class="restore-action" bindtap="onRestoreStack">恢复整组</view>
    </view>
  </view>

  <view wx:if="{{activeEditorTab === 'style'}}" class="editor-panel">
    <view wx:if="{{localEditorEnabled}}" class="solid-background-control">
      <view class="control-label">纯色背景</view>
      <view class="background-swatches"><button wx:for="{{backgroundColors}}" wx:key="*this" data-color="{{item}}" bindtap="onSelectSolidBackground" aria-label="{{'背景色 ' + item}}" class="background-swatch {{currentScene.background.assetKey === 'solid' && currentScene.background.color === item ? 'background-selected' : ''}}" style="background-color:{{item}};"></button></view>
    </view>
    <view class="scope-switch">
      <view class="scope-option {{editScope === 'card' ? 'scope-option-active' : ''}}" data-scope="card" bindtap="onSetEditScope">仅当前卡</view>
      <view class="scope-option {{editScope === 'stack' ? 'scope-option-active' : ''}}" data-scope="stack" bindtap="onSetEditScope">应用到整组</view>
    </view>
    <view class="control-label">整组风格</view>
    <scroll-view class="horizontal-controls" scroll-x enable-flex>
      <view class="style-packs-row">
        <view
          wx:for="{{stylePacks}}"
          wx:key="id"
          class="style-pack-chip {{item.id === selectedCandidate.stylePackId ? 'style-chip-active' : ''}}"
          data-style-pack-id="{{item.id}}"
          bindtap="onSelectStylePack"
        >
          <view class="style-preview {{item.patternClass}}" style="background-color: {{item.color || '#fff'}}; color: {{item.textColor}};">
            <text>字</text><view class="style-preview-accent" style="background: {{item.accentColor}};"></view>
          </view>
          <text class="style-name">{{item.name}}</text>
          <text wx:if="{{item.id === selectedCandidate.stylePackId}}" class="choice-status">当前</text>
        </view>
      </view>
    </scroll-view>
    <view class="control-label">背景</view>
    <view class="choice-grid">
      <view wx:for="{{styleControls.backgrounds}}" wx:key="key" class="visual-choice background-choice {{item.selected ? 'visual-choice-active' : ''}}" data-key="{{item.key}}" bindtap="onSelectBackground">
        <view class="background-swatch {{item.patternClass}}" style="background-color: {{item.color}}; color: {{item.previewTextColor}};">字</view>
        <text>{{item.name}}</text><text wx:if="{{item.selected}}" class="choice-check">✓</text>
      </view>
    </view>
    <view class="control-label">配色</view>
    <view class="choice-grid">
      <view wx:for="{{styleControls.palettes}}" wx:key="key" class="visual-choice {{item.selected ? 'visual-choice-active' : ''}}" data-key="{{item.key}}" bindtap="onSelectPalette">
        <view class="palette-swatch"><view class="palette-color" style="background: {{item.color}};"></view><view class="palette-color" style="background: {{item.accent}};"></view></view><text>{{item.name}}</text><text wx:if="{{item.selected}}" class="choice-check">✓</text>
      </view>
    </view>
    <view class="control-label">字感</view>
    <view class="font-options">
      <view wx:for="{{styleControls.fonts}}" wx:key="key" class="font-choice {{item.selected ? 'font-choice-active' : ''}}" data-key="{{item.key}}" bindtap="onSelectFontFeel">
        <view class="font-name">{{item.name}}</view><view class="font-desc">{{item.description}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{activeEditorTab === 'decoration'}}" class="editor-panel stickers-card">
    <view class="section-header">
      <text class="section-title">贴纸和涂鸦</text>
      <text class="section-hint">点素材添加，直接在画面拖动</text>
    </view>
    <scroll-view class="horizontal-controls" scroll-x enable-flex>
      <view class="decoration-list">
        <view wx:for="{{decorationAssets}}" wx:key="key" class="decoration-asset {{item.inScene ? 'decoration-asset-added' : ''}} {{item.selected ? 'decoration-asset-selected' : ''}}" data-asset-key="{{item.key}}" bindtap="onAddDecoration">
          <view class="asset-symbol asset-symbol-{{item.type}}">{{item.glyph}}</view>
          <view class="asset-key">{{item.name}}</view>
          <view class="asset-type">{{item.typeLabel}}{{item.addedCount ? ' · 已添加' : ''}}</view>
        </view>
      </view>
    </scroll-view>
    <view class="decoration-color-panel">
      <view class="decoration-color-header">
        <view>
          <view class="decoration-color-title">装饰颜色</view>
          <view class="decoration-color-subtitle">只修改当前选中的贴纸或涂鸦</view>
        </view>
        <view
          wx:if="{{selectedDecorationId}}"
          class="color-reset {{decorationColorIsDefault ? 'color-reset-active' : ''}}"
          bindtap="onResetDecorationColor"
        >恢复原色</view>
      </view>
      <view wx:if="{{selectedDecorationId}}">
        <view class="decoration-color-groups">
          <view
            wx:for="{{decorationColorGroups}}"
            wx:key="key"
            class="color-group-tab {{activeDecorationColorGroup === item.key ? 'color-group-tab-active' : ''}}"
            data-group-key="{{item.key}}"
            bindtap="onSelectDecorationColorGroup"
          >{{item.name}}</view>
        </view>
        <scroll-view class="decoration-color-scroll" scroll-x enable-flex>
          <view class="decoration-color-swatches">
            <view
              wx:for="{{decorationColorOptions}}"
              wx:key="key"
              class="decoration-color-choice {{item.selected ? 'decoration-color-choice-active' : ''}}"
              data-color-key="{{item.key}}"
              bindtap="onSetDecorationColor"
              aria-label="{{item.name}}"
            >
              <view class="decoration-color-dot-wrap {{item.transparent ? 'decoration-color-transparent' : ''}}">
                <view class="decoration-color-dot" style="{{item.swatchStyle}}"></view>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>
      <view wx:else class="decoration-color-empty">请先点击画面里的装饰，再选择颜色</view>
    </view>
    <view wx:if="{{selectedDecorationId}}" class="selected-decoration-tools">
      <view class="decoration-tool {{decorationLayerState.canMoveBackward ? '' : 'decoration-tool-disabled'}}" data-direction="backward" bindtap="onMoveDecorationLayer">置底</view>
      <view class="decoration-tool {{decorationLayerState.canMoveForward ? '' : 'decoration-tool-disabled'}}" data-direction="forward" bindtap="onMoveDecorationLayer">置顶</view>
      <view class="decoration-tool delete-decoration" bindtap="onDeleteDecoration">删除</view>
    </view>
    <view wx:if="{{selectedDecorationId}}" class="layer-help">只在装饰互相重叠时改变遮挡顺序；删除只移除当前选中的装饰</view>
    <view wx:else class="decoration-tip">选择画面里的装饰后，可以双指缩放和旋转</view>
    <view wx:if="{{selectedInkId}}" class="selected-decoration-tools">
      <button class="decoration-tool" bindtap="onEditInkSticker">编辑手写贴纸</button>
      <button class="decoration-tool delete-decoration" bindtap="onDeleteInkSticker">删除手写贴纸</button>
    </view>
  </view>

  <view wx:if="{{localEditorEnabled}}" class="project-draft-link" bindtap="onRestoreLocalDraft">恢复最近整套项目草稿 ›</view>

  <view wx:if="{{!handwritingVisible && !editingTextModalVisible}}" class="editor-footer editor-fixed-footer">
    <button class="editor-secondary" disabled="{{editorExportBusy}}" hover-class="button-pressed" bindtap="onWechatPreview">微信预览</button>
    <button class="btn-confirm-edits" disabled="{{editorExportBusy}}" hover-class="button-pressed" bindtap="onConfirmEdits">完成，制作这叠</button>
  </view>
  <canvas type="2d" id="editorExportCanvas" class="editor-export-canvas" />

  <view wx:if="{{exportProgress.visible}}" class="export-progress-mask" catchtouchmove="onExportMaskTouch" catchtap="onExportMaskTouch">
    <view class="export-progress-dialog" role="alert" aria-label="{{exportProgress.stage === 'preview' ? '正在本机准备预览' : exportProgress.stage === 'saving' ? '正在保存图片' : '正在审核并准备图片'}}">
      <view class="export-progress-icon"><view class="export-progress-ring"></view><text>{{exportProgress.stage === 'saving' ? '↓' : '✦'}}</text></view>
      <view class="export-progress-title">{{exportProgress.stage === 'preview' ? '正在准备微信预览' : exportProgress.stage === 'audit' ? '正在审核并生成' : exportProgress.stage === 'preparing' ? '正在准备图片' : '正在保存第 ' + exportProgress.current + ' / ' + exportProgress.total + ' 张'}}</view>
      <view class="export-progress-subtitle">{{exportProgress.stage === 'preview' ? '仅在本机生成，保存时才提交审核' : exportProgress.stage === 'audit' ? '正在检查内容并生成高清图片' : exportProgress.stage === 'preparing' ? '审核已通过，正在整理高清图片' : '审核已通过，正在保存到相册'}}</view>
      <view class="export-progress-track">
        <view wx:if="{{exportProgress.stage === 'saving'}}" class="export-progress-fill" style="width:{{exportProgress.percent}}%;"></view>
        <view wx:else class="export-progress-indeterminate"></view>
      </view>
      <view wx:if="{{exportProgress.stage !== 'preview'}}" class="export-progress-steps">
        <view class="export-progress-step {{exportProgress.stage === 'audit' ? 'export-step-active' : 'export-step-done'}}"><view class="export-step-dot">{{exportProgress.stage === 'audit' ? '' : '✓'}}</view><text>审核与成图</text></view>
        <view class="export-step-line"></view>
        <view class="export-progress-step {{exportProgress.stage === 'preparing' ? 'export-step-active' : exportProgress.stage === 'saving' ? 'export-step-done' : ''}}"><view class="export-step-dot">{{exportProgress.stage === 'saving' ? '✓' : ''}}</view><text>准备图片</text></view>
        <view class="export-step-line"></view>
        <view class="export-progress-step {{exportProgress.stage === 'saving' ? 'export-step-active' : ''}}"><view class="export-step-dot"></view><text>保存相册</text></view>
      </view>
      <view class="export-progress-hint">{{exportProgress.stage === 'saving' ? '已保存 ' + exportProgress.completed + ' / ' + exportProgress.total + ' 张 · 请保持页面打开' : '请稍候，完成后自动继续'}}<text class="export-progress-dots">···</text></view>
    </view>
  </view>

  <view wx:if="{{handwritingVisible}}" class="handwriting-mask" catchtouchmove="true">
    <view class="handwriting-sheet">
      <view class="handwriting-sheet-heading"><text>自由手写</text><button bindtap="onCancelHandwriting">关闭</button></view>
      <view class="handwriting-canvas"><fun-live-preview wx:if="{{!exportProgress.visible}}" local-only="{{true}}" scene="{{handwritingScene}}" drawing="{{true}}" pan-mode="{{handwritingPanMode}}" brush-key="{{brushKey}}" color-key="{{inkColor}}" pen-width="{{penWidth}}" bindinkchange="onHandwritingChange" bindviewportchange="onHandwritingViewport" bindinklimit="onInkLimit" /></view>
      <scroll-view scroll-y="true" class="handwriting-tools-scroll">
      <view class="handwriting-toolbar">
        <view wx:if="{{!handwritingEditing}}" class="ink-options"><button data-purpose="sticker" bindtap="onHandwritingPurpose" class="{{handwritingPurpose === 'sticker' ? 'ink-selected' : ''}}">加到当前卡</button><button data-purpose="card" bindtap="onHandwritingPurpose" class="{{handwritingPurpose === 'card' ? 'ink-selected' : ''}}">做成新卡</button></view>
        <view class="handwriting-save-status">{{handwritingEditing ? '更新当前选中的手写' : handwritingPurpose === 'card' ? '完整笔迹缩放放入新卡，原卡保留' : '透明笔迹添加到第 ' + (currentCardIndex + 1) + ' 张卡，不改变背景'}}</view>
        <view wx:if="{{handwritingPurpose === 'card'}}">
          <view class="control-label">新卡背景</view>
          <view class="background-swatches"><button wx:for="{{backgroundColors}}" wx:key="*this" data-color="{{item}}" bindtap="onHandwritingBackground" aria-label="{{'背景色 ' + item}}" class="background-swatch {{handwritingBackground === item ? 'background-selected' : ''}}" style="background-color:{{item}};"></button></view>
        </view>
        <view class="ink-options"><button data-mode="draw" bindtap="onHandwritingMode" class="{{!handwritingPanMode ? 'ink-selected' : ''}}">写画</button><button data-mode="pan" bindtap="onHandwritingMode" class="{{handwritingPanMode ? 'ink-selected' : ''}}">移动画布</button></view>
        <view class="handwriting-save-status">{{handwritingPanMode ? '拖动纸面查看其他位置；切回写画继续落笔' : '单指写画；需要更多空间时切换移动画布'}} · 保存完整作品</view>
        <view class="ink-options"><button disabled="{{!handwritingCanUndo}}" bindtap="onHandwritingUndo">↶ 撤销</button><button disabled="{{!handwritingCanRedo}}" bindtap="onHandwritingRedo">重做 ↷</button></view>
        <view class="ink-options"><button data-key="pen" bindtap="onInkBrush" class="{{brushKey === 'pen' ? 'ink-selected' : ''}}">实线笔</button><button data-key="highlighter" bindtap="onInkBrush" class="{{brushKey === 'highlighter' ? 'ink-selected' : ''}}">荧光笔</button><button data-key="eraser" bindtap="onInkBrush" class="{{brushKey === 'eraser' ? 'ink-selected' : ''}}">擦除</button></view>
        <view class="handwriting-save-status">{{brushKey === 'eraser' ? '橡皮大小' : '笔画粗细'}} · 左右滑动选择</view>
        <scroll-view scroll-x="true" class="ink-width-scroll"><view class="ink-width-row"><button wx:for="{{inkWidths}}" wx:key="*this" data-width="{{item}}" bindtap="onInkWidth" class="{{penWidth === item ? 'ink-selected' : ''}}">{{item}}</button></view></scroll-view>
        <view class="ink-options"><view wx:for="{{inkColors}}" wx:key="key" data-key="{{item.key}}" bindtap="onInkColor" class="ink-color {{inkColor === item.key ? 'ink-selected' : ''}}" style="background:{{item.color}};"></view></view>
        <view class="handwriting-save-status">{{handwritingStatus || '笔迹在本机编辑，仅保存到相册时审核'}}</view>
        <view wx:if="{{handwritingPurpose === 'card' && scenes.length >= 8}}" class="handwriting-save-status">已达8张上限，可先保存草稿，删除一张后再添加</view>
        <view class="ink-options"><button bindtap="onSaveHandwriting">保存草稿</button><button class="handwriting-start" disabled="{{handwritingPurpose === 'card' && scenes.length >= 8}}" bindtap="onAddHandwritingSticker">{{handwritingEditing ? '更新此手写' : handwritingPurpose === 'card' ? '添加为新卡 →' : '添加到当前卡 →'}}</button></view>
      </view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{editingTextModalVisible}}" class="modal-mask" catchtouchmove="true">
    <view class="modal-dialog">
      <view class="modal-title">修改第 {{currentCardIndex + 1}} 张文字</view>
      <view class="modal-input-wrap">
        <textarea class="modal-textarea" value="{{editingText}}" maxlength="{{maxCharCount}}" placeholder="请输入本卡文字" bindinput="onInputEditText" />
        <view class="modal-counter {{editingCharCount > maxCharCount ? 'counter-over' : ''}}">{{editingCharCount}} / {{maxCharCount}}</view>
      </view>
      <view class="modal-actions">
        <button class="btn-modal-cancel" bindtap="onCancelEditText">取消</button>
        <button class="btn-modal-confirm" bindtap="onConfirmText">确定</button>
      </view>
    </view>
  </view>
</view>
<view wx:if="{{imageViewerVisible}}" class="editor-image-viewer" catchtouchmove="onExportMaskTouch">
  <view class="editor-viewer-header"><text bindtap="onCloseImageViewer">‹ 返回</text><text>{{currentCardIndex + 1}} / {{scenes.length}}</text><text bindtap="onCloseImageViewer">关闭</text></view>
  <view wx:if="{{imageViewerLoading || imageViewerError}}" class="editor-viewer-state">{{imageViewerError || '正在准备预览…'}}</view>
  <swiper wx:else class="editor-viewer-swiper" current="{{currentCardIndex}}" duration="250" bindchange="onImageViewerChange">
    <swiper-item wx:for="{{imageViewerCards}}" wx:key="sceneId"><image class="editor-viewer-image" src="{{item.url}}" mode="aspectFit" show-menu-by-longpress="{{false}}" /></swiper-item>
  </swiper>
</view>
