/* pages/fun-text-editor/fun-text-editor.wxss */
.editor-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 120rpx;
  background: #fff8f9;
}

.editor-topbar {
  width: 640rpx;
  margin: 0 auto 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.history-action {
  min-width: 112rpx;
  color: #5d4ce8;
  font-size: 24rpx;
  font-weight: 600;
}

.history-action:last-child {
  text-align: right;
}

.history-action-disabled {
  color: #c8c4d3;
}

.editor-card-status {
  color: #8a7f8f;
  font-size: 22rpx;
}

.editor-stage {
  width: 640rpx;
  height: 640rpx;
  margin: 0 auto 22rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(243, 92, 140, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  position: relative;
}

.editor-stage-fallback {
  display: block;
  width: 320px;
  height: 320px;
}

.editor-preview-status {
  position: absolute;
  inset: 0;
  z-index: 5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  color: #5f5867;
  background: rgba(255, 255, 255, 0.94);
  text-align: center;
}

.editor-preview-status-title {
  font-size: 28rpx;
  font-weight: 700;
}

.editor-preview-status-text {
  margin-top: 10rpx;
  color: #9b94a2;
  font-size: 21rpx;
}

.editor-preview-retry {
  width: 210rpx;
  margin-top: 24rpx;
  padding: 12rpx 0;
  border-radius: 999rpx;
  color: #ffffff;
  background: #6c58f0;
  font-size: 22rpx;
  line-height: 1.4;
}

.editor-preview-retry::after {
  border: 0;
}

.decoration-overlay {
  position: absolute;
  inset: 0;
  z-index: 3;
  pointer-events: none;
}

.decoration-handle {
  position: absolute;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed transparent;
  border-radius: 12rpx;
  color: transparent;
  pointer-events: auto;
  touch-action: none;
}

.decoration-handle-selected {
  color: #5d4ce8;
  border-color: #5d4ce8;
  background: rgba(255, 255, 255, 0.2);
}

.editor-section {
  background: #ffffff;
  border: 2rpx solid #ffd3e2;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(243, 92, 140, 0.06);
}

.cards-section {
  margin-bottom: 18rpx;
}

.compact-header {
  margin-bottom: 10rpx;
}

.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #26211f;
}

.section-hint {
  font-size: 20rpx;
  color: #9d8f8b;
}

/* 缩略图条 */
.cards-scroll {
  width: 100%;
  white-space: nowrap;
}

.cards-movable-area {
  position: relative;
  min-width: 100%;
  margin: 4rpx 0 0;
}

.card-thumb-movable {
  position: absolute;
  left: 0;
  top: 0;
  transition: transform 200ms ease-out;
  box-sizing: border-box;
}

.card-order-actions { display: flex; gap: 6rpx; margin-top: 8rpx; }
.card-order-actions button { flex: 1; padding: 0; margin:0; min-width: 0; min-height:0; height: auto; aspect-ratio:1; display:flex; align-items:center; justify-content:center; line-height:1; font-size: 24rpx; background: #f1eef8; color: #68577e; border-radius: 12rpx; }
.card-order-actions button::after { border: 0; }
.card-order-actions .card-delete { color: #e5484d; background: #fff0f5; }
.card-order-actions button[disabled] { opacity: .35; }

.card-thumb-item {
  width: 100%;
  height: 100%;
  background: #fff0f5;
  border: 2rpx solid #ffd3e2;
  border-radius: 16rpx;
  box-sizing: border-box;
  padding: 12rpx 8rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
  transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
}

.thumb-active {
  border-color: #f35c8c;
  background: #ffe3ec;
  box-shadow: 0 6rpx 16rpx rgba(243, 92, 140, 0.2);
}

.thumb-dragging {
  opacity: 0.96;
  transform: scale(1.06);
  z-index: 5;
  box-shadow: 0 10rpx 24rpx rgba(81, 64, 223, 0.24);
}

.thumb-drop-target {
  border-color: #7664f5;
  box-shadow: 0 0 0 4rpx rgba(118, 100, 245, 0.12);
}

.thumb-badge {
  font-size: 18rpx;
  font-weight: 600;
  color: #8a7f7b;
}

.badge-cover {
  color: #e0447c;
  font-weight: 700;
}

.thumb-text {
  font-size: 20rpx;
  color: #26211f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 700;
  text-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.35);
  position: relative;
  z-index: 1;
}

.thumb-decorations {
  height: 24rpx;
  overflow: hidden;
  text-align: right;
  font-size: 22rpx;
  line-height: 24rpx;
  opacity: 0.75;
  position: relative;
  z-index: 1;
}

/* 改文字栏 */
.edit-text-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff8f9;
  border: 2rpx dashed #f35c8c;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
}

.edit-text-preview {
  font-size: 28rpx;
  font-weight: 600;
  color: #26211f;
  flex: 1;
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-text-action {
  font-size: 24rpx;
  font-weight: 600;
  color: #e0447c;
}

/* 换风格列表 */
.style-packs-row {
  display: flex;
  gap: 16rpx;
  padding: 4rpx 2rpx 10rpx;
}

.style-pack-chip {
  flex: none;
  width: 176rpx;
  min-height: 142rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 10rpx;
  background: #f9f9f9;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  position: relative;
}

.editor-tabs {
  display: flex;
  padding: 6rpx;
  margin-bottom: 18rpx;
  border-radius: 22rpx;
  background: #eeeaf9;
}

.editor-tab {
  flex: 1;
  padding: 18rpx 0;
  text-align: center;
  border-radius: 18rpx;
  color: #766f84;
  font-size: 27rpx;
  font-weight: 600;
}

.editor-tab-active {
  color: #5140df;
  background: #ffffff;
  box-shadow: 0 5rpx 14rpx rgba(77, 62, 180, 0.12);
}

.editor-panel {
  min-height: 300rpx;
  padding: 24rpx;
  border: 2rpx solid #e8e2f8;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(73, 57, 151, 0.06);
}

.control-label {
  margin: 24rpx 0 12rpx;
  color: #4a4353;
  font-size: 24rpx;
  font-weight: 700;
}

.size-options,
.restore-row,
.font-options,
.choice-grid,
.scope-switch,
.selected-decoration-tools {
  display: flex;
  gap: 12rpx;
}

.size-chip,
.restore-action {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  border-radius: 16rpx;
  background: #f4f1ff;
  color: #5d4ce8;
  font-size: 24rpx;
}

.restore-row {
  margin-top: 22rpx;
}

.restore-action {
  color: #756d82;
  background: #f7f6f8;
}

.scope-switch {
  padding: 5rpx;
  border-radius: 18rpx;
  background: #f2effa;
}

.scope-option {
  flex: 1;
  padding: 14rpx 0;
  text-align: center;
  border-radius: 14rpx;
  color: #81798d;
  font-size: 23rpx;
}

.scope-option-active {
  color: #5140df;
  background: #ffffff;
  font-weight: 700;
}

.horizontal-controls {
  width: 100%;
  white-space: nowrap;
}

.choice-grid {
  flex-wrap: wrap;
}

.visual-choice {
  min-width: 180rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx;
  border: 2rpx solid #ebe8ef;
  border-radius: 16rpx;
  color: #665f70;
  font-size: 22rpx;
  position: relative;
}

.visual-choice-active {
  color: #5140df;
  border-color: #7664f5;
  background: #f5f2ff;
}

.background-swatch {
  width: 58rpx;
  height: 58rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 9rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.palette-swatch {
  display: flex;
  width: 40rpx;
  height: 30rpx;
  overflow: hidden;
  border-radius: 9rpx;
}

.palette-color {
  flex: 1;
}

.font-choice {
  flex: 1;
  padding: 16rpx 10rpx;
  text-align: center;
  border: 2rpx solid #ebe8ef;
  border-radius: 16rpx;
}

.font-choice-active {
  border-color: #7664f5;
  background: #f5f2ff;
}

.font-name {
  color: #393243;
  font-size: 25rpx;
  font-weight: 700;
}

.font-desc {
  margin-top: 5rpx;
  color: #9891a2;
  font-size: 19rpx;
}

.decoration-list {
  display: inline-flex;
  gap: 12rpx;
  padding: 4rpx 2rpx 14rpx;
}

.decoration-asset {
  width: 132rpx;
  min-height: 144rpx;
  padding: 12rpx 8rpx 10rpx;
  box-sizing: border-box;
  text-align: center;
  border: 2rpx solid #ebe8ef;
  border-radius: 16rpx;
  background: #faf9fc;
}

.decoration-asset-added {
  border-color: #b9adef;
  background: #f6f3ff;
}

.decoration-asset-selected {
  border-color: #6c58f0;
  box-shadow: 0 0 0 4rpx rgba(108, 88, 240, 0.12);
}

.asset-symbol {
  color: #6c58f0;
  height: 58rpx;
  font-size: 46rpx;
  line-height: 58rpx;
}

.asset-symbol-doodle {
  color: #26211f;
  font-weight: 500;
}

.asset-key {
  margin-top: 4rpx;
  color: #81798d;
  font-size: 20rpx;
  font-weight: 600;
}

.asset-type {
  margin-top: 3rpx;
  color: #a29aaa;
  font-size: 16rpx;
}

.decoration-color-panel {
  margin-top: 8rpx;
  padding: 20rpx 18rpx 18rpx;
  border: 2rpx solid #ebe8ef;
  border-radius: 24rpx;
  background: #ffffff;
}

.decoration-color-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.decoration-color-title {
  color: #302b36;
  font-size: 24rpx;
  font-weight: 700;
}

.decoration-color-subtitle {
  margin-top: 4rpx;
  color: #a099a8;
  font-size: 18rpx;
}

.color-reset {
  flex-shrink: 0;
  padding: 9rpx 15rpx;
  border-radius: 999rpx;
  color: #5d4ce8;
  background: #f1eeff;
  font-size: 19rpx;
}

.color-reset-active {
  color: #8c8693;
  background: #f3f2f5;
}

.decoration-color-groups {
  display: flex;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 5rpx;
  border-radius: 16rpx;
  background: #f4f2f8;
}

.color-group-tab {
  flex: 1;
  padding: 10rpx 4rpx;
  border-radius: 12rpx;
  color: #8b8494;
  font-size: 20rpx;
  font-weight: 600;
  text-align: center;
}

.color-group-tab-active {
  color: #4e3fe0;
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(76, 62, 190, 0.09);
}

.decoration-color-scroll {
  margin-top: 14rpx;
  white-space: nowrap;
}

.decoration-color-swatches {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-width: 100%;
  padding: 2rpx;
  box-sizing: border-box;
}

.decoration-color-choice {
  display: flex;
  flex: 0 0 64rpx;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.decoration-color-choice-active {
  border-color: #d8dbe3;
  background: #f3f4f6;
  box-shadow: 0 2rpx 7rpx rgba(25, 30, 45, 0.08);
}

.decoration-color-dot-wrap {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  overflow: hidden;
  border: 2rpx solid rgba(28, 30, 35, 0.08);
  border-radius: 999rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.decoration-color-transparent {
  background-color: #ffffff;
  background-image:
    linear-gradient(45deg, #dcdde2 25%, transparent 25%),
    linear-gradient(-45deg, #dcdde2 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, #dcdde2 75%),
    linear-gradient(-45deg, transparent 75%, #dcdde2 75%);
  background-position: 0 0, 0 9rpx, 9rpx -9rpx, -9rpx 0;
  background-size: 18rpx 18rpx;
}

.decoration-color-dot {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: inherit;
}

.decoration-color-empty {
  margin-top: 16rpx;
  padding: 22rpx 12rpx;
  border-radius: 14rpx;
  color: #96909e;
  background: #f8f7fa;
  font-size: 20rpx;
  text-align: center;
}

.selected-decoration-tools {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.decoration-tool {
  flex: 1;
  padding: 15rpx 0;
  text-align: center;
  border-radius: 14rpx;
  color: #5d4ce8;
  background: #f1eeff;
  font-size: 22rpx;
}

.delete-decoration {
  color: #d4425d;
  background: #fff0f3;
}

.decoration-tool-disabled {
  color: #aaa4b2;
  background: #f5f4f7;
}

.layer-help {
  margin-top: 12rpx;
  color: #9891a2;
  font-size: 20rpx;
  line-height: 1.45;
  text-align: center;
}

.decoration-tip {
  margin-top: 18rpx;
  color: #9891a2;
  font-size: 22rpx;
  text-align: center;
}

.style-chip-active {
  background: #fff0f5;
  border-color: #f35c8c;
  box-shadow: 0 4rpx 12rpx rgba(243, 92, 140, 0.15);
}

.style-preview {
  width: 148rpx;
  height: 78rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 800;
  position: relative;
  overflow: hidden;
}

.style-preview-accent {
  width: 20rpx;
  height: 20rpx;
  border-radius: 999rpx;
  position: absolute;
  right: 12rpx;
  top: 10rpx;
}

.choice-status {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  padding: 2rpx 8rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #e0447c;
  font-size: 16rpx;
}

.choice-check {
  margin-left: auto;
  color: #5140df;
  font-size: 22rpx;
  font-weight: 800;
}

.style-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #26211f;
}

.style-chip-active .style-name {
  color: #e0447c;
}

.preview-pattern-note {
  background-image: linear-gradient(90deg, rgba(255, 255, 255, 0.42) 1rpx, transparent 1rpx);
  background-size: 18rpx 18rpx;
}

.preview-pattern-chalk {
  background-image: radial-gradient(rgba(255, 255, 255, 0.18) 1rpx, transparent 1rpx);
  background-size: 12rpx 12rpx;
}

.preview-pattern-paper {
  background-image: linear-gradient(8deg, transparent 47%, rgba(90, 70, 40, 0.12) 49%, transparent 51%);
  background-size: 24rpx 24rpx;
}

.preview-pattern-grid {
  background-image: linear-gradient(rgba(23, 23, 23, 0.14) 1rpx, transparent 1rpx), linear-gradient(90deg, rgba(23, 23, 23, 0.14) 1rpx, transparent 1rpx);
  background-size: 22rpx 22rpx;
}

.preview-pattern-journal {
  background-image: linear-gradient(rgba(140, 120, 155, 0.12) 1rpx, transparent 1rpx);
  background-size: 100% 18rpx;
}

.preview-pattern-soda {
  background-image: radial-gradient(circle at 22% 28%, rgba(255, 255, 255, 0.75) 0 5rpx, transparent 6rpx), radial-gradient(circle at 78% 65%, rgba(255, 255, 255, 0.6) 0 7rpx, transparent 8rpx);
}

.preview-pattern-ticket {
  background-image: linear-gradient(90deg, rgba(80, 55, 35, 0.2) 50%, transparent 50%);
  background-size: 12rpx 2rpx;
  background-position: 0 10rpx;
  background-repeat: repeat-x;
}

/* 底部按钮 */
.editor-footer {
  margin-top: 40rpx;
  padding: 0 16rpx;
}

.btn-confirm-edits {
  background: linear-gradient(135deg, #f35c8c, #f07856);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 24rpx 0;
  border: none;
  box-shadow: 0 10rpx 24rpx rgba(243, 92, 140, 0.28);
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10000;
  isolation: isolate;
  box-sizing: border-box;
  padding: 40rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
}

.modal-dialog {
  width: 600rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 36rpx 28rpx 28rpx;
  box-sizing: border-box;
  position: relative;
  z-index: 10001;
  box-shadow: 0 20rpx 60rpx rgba(38, 33, 31, 0.24);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #26211f;
  text-align: center;
  margin-bottom: 24rpx;
}

.modal-input-wrap {
  position: relative;
  background: #fff8f9;
  border: 2rpx solid #ffd3e2;
  border-radius: 16rpx;
  padding: 16rpx;
}

.modal-textarea {
  width: 100%;
  height: 160rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #26211f;
}

.modal-counter {
  text-align: right;
  font-size: 20rpx;
  color: #8a7f7b;
  margin-top: 8rpx;
}

.counter-over {
  color: #e5484d;
  font-weight: 600;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.btn-modal-cancel {
  flex: 1;
  background: #f5f5f5;
  color: #6d625e;
  font-size: 28rpx;
  border-radius: 999rpx;
  padding: 18rpx 0;
}

.btn-modal-confirm {
  flex: 1;
  background: linear-gradient(135deg, #f35c8c, #f07856);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 18rpx 0;
}
.editor-quick-edit { text-align: center; color: #f35c8c; padding: 16rpx; margin-top: -16rpx; margin-bottom: 16rpx; font-size: 26rpx; }
.ink-tools { margin-bottom:24rpx; }
.ink-options { display:flex; gap:12rpx; margin:12rpx 0; }
.ink-options button { flex:1; font-size:24rpx; padding:0 8rpx; }
.ink-color { width:64rpx; height:64rpx; border-radius:50%; border:4rpx solid #ddd; }
.ink-selected { outline:4rpx solid #7657ff; }

/* Reference layout: keep the live canvas, refine only this editor's controls. */
.editor-page { padding:24rpx 20rpx calc(32rpx + env(safe-area-inset-bottom)); background:linear-gradient(180deg,#fff6fa,#fffafb 55%,#fff7fa); }
.editor-section,.editor-panel { padding:24rpx; border-radius:20rpx; background:#fff; box-shadow:0 5rpx 18rpx #614bc207; margin-bottom:16rpx; }
.cards-section { border:2rpx solid #ffcee4; }
.editor-panel { border:2rpx solid #e7dfff; }
.section-title { font-size:28rpx; font-weight:700; color:#151515; }
.section-hint { font-size:20rpx; color:#909094; }
.editor-quick-edit { color:#ff4893; font-size:26rpx; font-weight:600; padding:20rpx 0; margin:0 0 8rpx; }
.editor-tabs { padding:5rpx; margin:0 0 16rpx; border-radius:22rpx; background:#f0eafb; }
.editor-tab { padding:18rpx 0; font-size:28rpx; font-weight:600; color:#777184; }
.editor-tab-active { background:#fff; color:#6743ff; border-radius:18rpx; box-shadow:0 6rpx 12rpx #5745a012; }
.handwriting-heading { display:flex; align-items:center; gap:18rpx; margin-bottom:18rpx; }
.content-handwriting { margin:24rpx 0; padding:24rpx 0; border-top:1rpx solid #eee8f5; border-bottom:1rpx solid #eee8f5; }
.add-blank-card { margin:0 0 0 12rpx; padding:0 12rpx; line-height:64rpx; flex-shrink:0; font-size:22rpx; color:#7657ff; background:#f2edfa; border-radius:12rpx; }
.add-blank-card::after { border:0; }
.cards-section .compact-header { flex-wrap:wrap; }
.background-swatches { display:flex; flex-wrap:wrap; gap:16rpx; margin:16rpx 0 24rpx; }
.background-swatches .background-swatch { flex:none; width:56rpx; height:56rpx; min-height:56rpx; margin:0; padding:0; border:2rpx solid #ded8e8; border-radius:50%; box-sizing:border-box; }
.background-swatch::after { border:0; }
.background-swatches .background-selected { outline:3rpx solid #7657ff; outline-offset:4rpx; }
.pen-tile { width:88rpx; height:88rpx; background:#fff0f9; border-radius:20rpx; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.pen-icon { width:12rpx; height:42rpx; border:5rpx solid #ff3d93; border-radius:5rpx; transform:rotate(38deg); position:relative; }
.pen-icon::after { content:''; position:absolute; left:1rpx; bottom:-15rpx; border-left:5rpx solid transparent; border-right:5rpx solid transparent; border-top:10rpx solid #ff3d93; }
.handwriting-intro { flex:1; min-width:0; }
.handwriting-title { font-size:28rpx; font-weight:700; color:#171717; white-space:nowrap; }
.help-icon { display:inline-flex; justify-content:center; align-items:center; width:26rpx; height:26rpx; border:2rpx solid #d7d3e3; border-radius:50%; color:#9992aa; font-size:20rpx; margin-left:8rpx; }
.handwriting-subtitle { display:block; font-size:19rpx; color:#939095; margin-top:10rpx; line-height:1.5; }
.handwriting-start { width:210rpx; flex-shrink:0; color:#fff; background:linear-gradient(110deg,#ff4595,#ff7258); box-shadow:0 8rpx 18rpx #ff5c7e24; border-radius:999rpx; padding:0 12rpx; font-size:24rpx; font-weight:600; line-height:66rpx; margin:0; }
.handwriting-start::after,.handwriting-sheet button::after { border:0; }
.draft-library { background:#faf9fc; border:1rpx solid #f0eef6; border-radius:18rpx; padding:14rpx; }
.draft-heading { display:flex; justify-content:space-between; align-items:center; gap:8rpx; margin-bottom:14rpx; }
.draft-title { font-size:22rpx; font-weight:600; color:#292630; }
.draft-actions { display:flex; align-items:center; color:#98929f; font-size:17rpx; gap:12rpx; }
.draft-clear { padding:8rpx 0 8rpx 8rpx; text-decoration:underline; }
.draft-row { display:flex; gap:12rpx; }
.draft-tile { width:112rpx; height:116rpx; flex-shrink:0; border:1rpx solid #eae6f0; border-radius:14rpx; background:#fff; display:flex; flex-direction:column; align-items:center; justify-content:center; overflow:hidden; box-sizing:border-box; box-shadow:0 4rpx 9rpx #4f3f6805; }
.draft-new { border:2rpx dashed #cec7df; color:#8b839e; font-size:17rpx; box-shadow:none; }
.draft-plus { color:#655c77; font-size:38rpx; line-height:1.4; }
.draft-image { width:90rpx; height:88rpx; pointer-events:none; }
.draft-date { font-size:14rpx; color:#999; white-space:nowrap; }
.draft-empty { color:#958ca5; font-size:20rpx; padding:24rpx 8rpx; }
.draft-empty text { display:block; font-size:18rpx; margin-top:12rpx; color:#b0a9bb; }
.handwriting-save-status { color:#8e8298; font-size:20rpx; padding-top:12rpx; line-height:1.5; }
.decoration-asset { min-width:120rpx; width:120rpx; padding:16rpx 0 12rpx; border-radius:14rpx; background:#faf9fc; border:2rpx solid #e4e0ed; }
.decoration-asset.decoration-asset-added { border-color:#7952ff; }
.decoration-asset-selected { border-color:#7952ff; box-shadow:0 0 0 3rpx #ece4ff; background:#f6f1ff; }
.asset-symbol { color:#7045ff; font-size:40rpx; }
.asset-key { color:#716781; font-size:23rpx; margin-top:4rpx; }
.asset-type { color:#9992a6; font-size:17rpx; }
.decoration-color-panel { border-radius:20rpx; border-color:#e5dfef; padding:18rpx; margin-top:22rpx; }
.selected-decoration-tools { gap:12rpx; }
.decoration-tool { border-radius:12rpx; background:#f2edff; color:#7754ff; font-size:23rpx; }
.decoration-tool-disabled { background:#f5f4f7; color:#a09aaa; }
.delete-decoration { color:#f23868; background:#fff0f5; }
.layer-help { font-size:18rpx; color:#97909f; margin-top:12rpx; text-align:center; }
.editor-footer { padding:8rpx 0 18rpx; }
.btn-confirm-edits { width:368rpx; max-width:90%; padding:0; line-height:80rpx; font-size:28rpx; background:linear-gradient(110deg,#ff4097,#ff7356); box-shadow:0 12rpx 26rpx #ff61942a; }
.project-draft-link { text-align:center; color:#a095ad; font-size:19rpx; padding:4rpx 0 18rpx; }
.button-pressed { opacity:.78; transform:scale(.98); }
.editor-tab:active,.decoration-asset:active,.color-reset:active,.decoration-tool:active { opacity:.72; }
.ink-sticker-overlay { position:absolute; inset:0; pointer-events:none; }
.ink-sticker-handle { position:absolute; pointer-events:auto; box-sizing:border-box; border:2rpx solid transparent; }
.ink-sticker-selected { border:2rpx dashed #8061ff; }
.ink-sticker-label { position:absolute; left:0; bottom:100%; font-size:18rpx; white-space:nowrap; color:#7952ff; background:#ffffffe6; padding:5rpx; }
.handwriting-mask { position:fixed; inset:0; z-index:100; display:flex; align-items:flex-end; background:#29203266; }
.handwriting-sheet { width:100%; height:94%; display:flex; flex-direction:column; overflow:hidden; background:#fffafd; border-radius:28rpx 28rpx 0 0; box-sizing:border-box; }
.handwriting-sheet-heading { padding:24rpx; display:flex; justify-content:space-between; align-items:center; font-size:30rpx; font-weight:700; }
.handwriting-sheet-heading button { font-size:24rpx; margin:0; color:#88779b; background:transparent; }
.handwriting-canvas { position:relative; flex-shrink:0; width:min(650rpx,48vh); height:min(650rpx,48vh); margin:0 auto; border:2rpx solid #e8dff5; border-radius:18rpx; overflow:hidden; background-color:#fff; background-image:linear-gradient(45deg,#f5f1f7 25%,transparent 25%,transparent 75%,#f5f1f7 75%),linear-gradient(45deg,#f5f1f7 25%,transparent 25%,transparent 75%,#f5f1f7 75%); background-size:32rpx 32rpx; background-position:0 0,16rpx 16rpx; }
.handwriting-sheet-heading { flex-shrink:0; }
.handwriting-tools-scroll { flex:1; height:0; min-height:0; }
.ink-width-row { display:flex; gap:12rpx; padding:8rpx 4rpx; }
.ink-width-row button { flex-shrink:0; width:100rpx; margin:0; }
.handwriting-toolbar { padding:12rpx 30rpx calc(24rpx + env(safe-area-inset-bottom)); }
.handwriting-toolbar button { min-height:64rpx; line-height:64rpx; border-radius:14rpx; color:#7954d9; background:#f2edfa; }
.handwriting-toolbar .handwriting-start { color:#fff; background:linear-gradient(110deg,#ff4595,#ff7258); }
.handwriting-toolbar .ink-selected { outline:2rpx solid #8a63ff; background-color:#e9e0ff; }
.handwriting-toolbar .ink-color { width:60rpx; height:60rpx; margin:4rpx; border-color:#e6deed; }
.editor-page { padding-bottom:calc(150rpx + env(safe-area-inset-bottom)); }
.editor-save-actions { display:flex; gap:20rpx; margin:24rpx 0; }
.editor-save-actions button,.editor-fixed-footer button { flex:1; width:auto; max-width:none; margin:0; font-size:28rpx; line-height:88rpx; border-radius:20rpx; }
.editor-secondary { background:#f0ebff; color:#7045ff; border:2rpx solid #e7dfff; }
.editor-primary { background:linear-gradient(110deg,#ff4097,#ff7356); color:#fff; }
.editor-save-actions { justify-content:center; gap:16rpx; margin:16rpx 0; }
.editor-save-actions button { flex:0 1 270rpx; font-size:24rpx; line-height:64rpx; min-height:64rpx; padding:0 16rpx; border-radius:16rpx; box-shadow:none; }
.editor-save-actions .editor-primary { background:#6670f6; color:#fff; }
.editor-footer.editor-fixed-footer { position:fixed; left:0; right:0; bottom:0; z-index:30; display:flex; gap:20rpx; padding:20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom)); background:#fff; box-shadow:0 -4rpx 20rpx #46366b08; }
.editor-export-canvas { position:fixed; left:-3000px; top:-3000px; width:1080px; height:1080px; pointer-events:none; }
.export-progress-mask {
  position: fixed; inset: 0; z-index: 10000;
  display: flex; align-items: center; justify-content: center;
  padding: 32rpx; box-sizing: border-box;
  background: rgba(246, 240, 249, .66);
}
.export-progress-dialog {
  width: 100%; max-width: 600rpx; box-sizing: border-box;
  padding: 40rpx 32rpx; border-radius: 24rpx;
  border: 2rpx solid #e6dcff;
  background: linear-gradient(145deg, #fff 55%, #fcf7ff);
  box-shadow: 0 12rpx 28rpx rgba(57,63,101,.12); text-align: center;
  animation: export-dialog-in .2s ease-out;
}
.export-progress-icon {position: relative; width: 104rpx; height: 104rpx; margin: 0 auto 24rpx; display:flex; align-items:center; justify-content:center; color:#8757ff; font-size:48rpx;}
.export-progress-ring {position:absolute; inset:0; border:6rpx solid #eee6ff; border-top-color:#b074ff; border-right-color:#ef74ba; border-radius:50%; animation:export-ring-spin 1.2s linear infinite;}
.export-progress-title {font-size:32rpx; font-weight:700; line-height:1.4; color:#151728;}
.export-progress-subtitle {margin-top:12rpx; font-size:24rpx; line-height:1.5; color:#8b90a6;}
.export-progress-track {height:12rpx; margin:32rpx 8rpx; border-radius:999rpx; background:#eee9f5; overflow:hidden; position:relative;}
.export-progress-fill {height:100%; background:linear-gradient(90deg,#ff65b1,#9761ff); border-radius:999rpx; transition:width .25s ease;}
.export-progress-indeterminate {height:100%; width:36%; border-radius:999rpx; background:linear-gradient(90deg,#ff8bc3,#a777ff); animation:export-track-slide 1.5s ease-in-out infinite;}
.export-progress-steps {display:flex; align-items:flex-start; justify-content:space-between; margin-top:24rpx;}
.export-progress-step {font-size:22rpx; color:#a7a2b2; flex-shrink:0;}
.export-step-dot {width:30rpx; height:30rpx; border:2rpx solid #d8d2e3; border-radius:50%; margin:0 auto 12rpx; font-size:22rpx; line-height:30rpx;}
.export-step-line {flex:1; height:2rpx; background:#e6deef; margin:16rpx 8rpx 0;}
.export-step-active,.export-step-done {color:#8757ff;}
.export-step-active .export-step-dot {border-color:#a878ff; background:#a878ff; animation:export-step-pulse 1.5s ease-in-out infinite;}
.export-step-done .export-step-dot {border-color:#a878ff; background:#a878ff; color:white;}
.export-progress-hint {margin-top:32rpx; font-size:22rpx; line-height:1.5; color:#8b90a6;}
.export-progress-dots {display:inline-block; animation:export-dots-pulse 1.4s ease-in-out infinite;}
@keyframes export-ring-spin {to {transform:rotate(360deg);}}
@keyframes export-track-slide {0% {transform:translateX(-100%);} 100% {transform:translateX(380%);}}
@keyframes export-step-pulse {50% {box-shadow:0 0 0 8rpx rgba(168,120,255,.16);}}
@keyframes export-dots-pulse {50% {opacity:.25;}}
@keyframes export-dialog-in {from {opacity:0; transform:translateY(12rpx);} to {opacity:1; transform:translateY(0);}}
.editor-image-viewer { position:fixed; inset:0; z-index:9999; background:#000; color:#fff; display:flex; flex-direction:column; }
.editor-viewer-header { display:flex; justify-content:space-between; padding:24rpx 32rpx; }
.editor-viewer-header text { padding:16rpx; }
.editor-viewer-swiper { flex:1; height:80vh; padding-bottom:env(safe-area-inset-bottom); }
.editor-viewer-image { width:100%; height:100%; }
.editor-viewer-state { margin:auto; padding:32rpx; }
.card-slide-next { animation:cardSlideNext .25s ease-out; }
.card-slide-prev { animation:cardSlidePrev .25s ease-out; }
@keyframes cardSlideNext { from { transform:translateX(28rpx); opacity:.7; } to { transform:translateX(0); opacity:1; } }
@keyframes cardSlidePrev { from { transform:translateX(-28rpx); opacity:.7; } to { transform:translateX(0); opacity:1; } }
